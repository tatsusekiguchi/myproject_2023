script.
	var paramsPc = {
		// アニメーションを表示したい要素(今回はlottieというidを付けて取得しています。)
		container: document.getElementById('lottiePc'),
		// アニメーションをsvg形式で出力
		renderer: 'svg',
		// アニメーションをループする
		loop: true,
		// アニメーションを読み込んだら自動で再生する
		autoplay: true,
		// アニメーションファイル(.json)のパス
		path: "js/data.json",
		rendererSettings: {
			className: 'lottie'
		}
	};
	var paramsSp = {
		// アニメーションを表示したい要素(今回はlottieというidを付けて取得しています。)
		container: document.getElementById('lottieSp'),
		// アニメーションをsvg形式で出力
		renderer: 'svg',
		// アニメーションをループする
		loop: true,
		// アニメーションを読み込んだら自動で再生する
		autoplay: true,
		// アニメーションファイル(.json)のパス
		path: "js/dataSp.json",
		rendererSettings: {
			className: 'lottie'
		}
	};
	$(window).on("load", function () {
		$("#logoContainer").fadeOut(500, function () {
			$(".lottieBox").fadeIn(200, function () {
				var animPc = lottie.loadAnimation(paramsPc);
				var animSp = lottie.loadAnimation(paramsSp);
				setTimeout(function () {
					$(".lottieBox").fadeOut(500, function () {
					$(".mvTitle").css("opacity", "1");
					});
				}, 500);
			});
		});
	});
