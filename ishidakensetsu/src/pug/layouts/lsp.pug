						.ul
							.li
								img(src="https://ishida-kensetsu.net/system_panel/uploads/images/lsp_sec04_img_04.png", alt="")
							.li
								img(src="https://ishida-kensetsu.net/system_panel/uploads/images/lsp_sec04_img_05.png", alt="")
				.dl
