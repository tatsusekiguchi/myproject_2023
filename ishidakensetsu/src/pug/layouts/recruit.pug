						.dl
							.dt
								p.span お名前
								p.em 必須
							.dd
								input(type="text" class="name" name="name" placeholder="例）石田　太朗" data-displaynameattr="お名前").validateRequired
						.dl
							.dt
								p.span フリガナ
							.dd
								input(type="text" class="kana" name="kana" placeholder="例）イシダ　タロウ" data-displaynameattr="ふりがな")
						.dl
							.dt
								p.span 生年月日
								p.em 必須
							.dd
								.selectBox
									select(name="year" data-displaynameattr="生年月日(年)").validateRequired
										option(value="") 年
										- for (var x = 1960; x < 2021; x++)
											option(value=x) #{x}
								p.span 年
								.selectBox
									select(name="month" data-displaynameattr="生年月日(月)").validateRequired
										option(value="") 月
										- for (var x = 1; x < 13; x++)
											option(value=x) #{x}
								p.span 月
								.selectBox
									select(name="day" data-displaynameattr="生年月日(日)").validateRequired
										option(value="") 日
										- for (var x = 1; x < 32; x++)
											option(value=x) #{x}
								p.span 日
						.dl
							.dt
								p.span 最終学歴（学校名）
								p.em 必須
							.dd
								input(type="text" name="educational" placeholder="例）石田大学　〇〇学部・〇〇会社" data-displaynameattr="最終学歴（学校名）").validateRequired
						.dl.postal
							.dt
								p.span 郵便番号
							.dd
								p.postalTxt 〒
								input(type="text" class="postal_01 zip1" name="postal_01" placeholder="123" data-displaynameattr="郵便番号上3桁" )
								p.span -
								input(type="text" class="postal_02 zip2" name="postal_02" placeholder="4567" data-displaynameattr="郵便番号下4桁" )
						.dl
							.dt
