// ▽メイン▽
.facilityMain.main
    .sideNav
        .ul
            .li.navRecruit
                a(href="recruit")
                    div
                        p 求人募集はこちら
            .li.navEstimate
                a(href="estimate")
                    div
                        p お見積りはこちら
    .pageKvPanel
        .pageKvTitle
            h1 設備紹介
            p Main Facilities
    .topContainer
        .secWrap01
            .secTitleBox
                .secTitle
                    h2 設備
                .subBox
                    .sub
                        p Facilities
            .messageBox
                .titleBand
                    p 精密機器・金型関連の製造販売に携わり、
                    p 一歩一歩発展して参りました。
                .txt
                    p こちらでは株式会社トムラスで活躍する主な設備をご紹介致します。
    .topPhoto
        .secWrap01
            .photo
                img(src="https://tomurasu230414.smooooth.jp/system_panel/uploads/images/facility_top_photo.png", alt="")
    .sec01.section
        .secWrap01
            h3 主要設備・機器のご紹介
            .listBox
                .ul
                    .li
                        .img
                            img(src="https://tomurasu230414.smooooth.jp/system_panel/uploads/images/facility_sec01_list_01.png", alt="")
                        p 成型研削盤
                    .li
                        .img
                            img(src="https://tomurasu230414.smooooth.jp/system_panel/uploads/images/facility_sec01_list_02.png", alt="")
                        p 平面研削盤
                    .li
                        .img
                            img(src="https://tomurasu230414.smooooth.jp/system_panel/uploads/images/facility_sec01_list_03.png", alt="")
                        p 円筒研削盤
                    .li
                        .img
                            img(src="https://tomurasu230414.smooooth.jp/system_panel/uploads/images/facility_sec01_list_04.png", alt="")
                        p 内面研削盤
                    .li
                        .img
                            img(src="https://tomurasu230414.smooooth.jp/system_panel/uploads/images/facility_sec01_list_05.png", alt="")
                        p ワイヤー放電加工
                    .li
                        .img
                            img(src="https://tomurasu230414.smooooth.jp/system_panel/uploads/images/facility_sec01_list_06.png", alt="")
                        p 型彫放電加工機
                    .li
                        .img
                            img(src="https://tomurasu230414.smooooth.jp/system_panel/uploads/images/facility_sec01_list_07.png", alt="")
