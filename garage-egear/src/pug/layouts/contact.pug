// ▽メイン▽
.contactMain.main
    .pageKvPanel
        h1 お問い合わせ
    .sec01
        .secWrap02
            .pageSecTtlBox
                .pageSecTtl
                    p ローン車買取の無料
                    p.em 査
                    p 定お申込みはこちら
                h2 ローン車買取の無料査定お申込みはこちら
            .txt
                p イーギアはローン車買取専門店です。<br>当店は創立23年で5,000台以上のローン車買取の実績があります。<br>お問い合わせ頂きましたら、即日対応致します。<br>まずはご安心して、お問い合わせ下さい。
            .cntBox
                h3 お問い合わせの際にご用意いただきたい内容
                .dl
                    .dt
                        p 車検証をご用意の上、下記の項目をお伝えください。
                    .dd
                        p ①車種、②年式、③グレード、④走行距離、⑤ボディカラー<br>⑥ハンドル 右・左、⑦装備・オプション、⑧車両状態、⑨登録番号、<br>⑩車台番号、⑪自動車税本年度未納 有無
    .pageContactContainer
        .pageContactPanel
            h2 ローン車の買取はイーギアまで
            .contactItem
                .lineItem
                    .lineBox
                        .dl
                            .dt
                                p 24時間365日対応
                            .dd
                                p LINE査定
                        .qrBox
                            .qr
                                a(href="https://line.me/ti/p/qhfWLoMD-l", target="_blank", rel="noopener")
                                    div
                                        img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/page_contact_line_qr.png", alt="")
                            .txt
                                p メッセージに<br>「お名前」「お車の画像」<br>「車種」「グレード」「走行距離」<br>等をお送りください。<br>後ほどお電話差し上げます。
                .telItem
                    .telBox01
                        .ttl
                            p.span お電話で無料査定はこちら
                            p.em 電話相談
                        a(href="tel:0120966288")
                            div
                                p 0120-966-288
                    .telBox02
                        a(href="tel:09052460051")
                            div
                                p.em 090-5246-0051
                                p.span 営業時間　10:00 - 20:00
    .sec02
        .secWrap
            .secContainer
                .secWrap01
                    .pageSecTtlBox
                        .pageSecTtl
                            p LINEで
                            p.em 簡
                            p 単査定！
                        h2 LINEで簡単査定！
                    .stepPanelList
                        .stepPanel
                            .ttl
                                .num
                                    p.span STEP
                                    p.em 01
                                h3 「ガレージイーギア(G-E-G)」をLINEでお友達登録
                            .cntBody
                                .qrBox
                                    .qr
                                        a(href="https://line.me/ti/p/qhfWLoMD-l", target="_blank", rel="noopener")
                                            div
                                                img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/contact_sec02_qr.png", alt="")
                                    .txtBox
                                        .txt
                                            p LINEの「お友達追加」から登録ください。<br>「QRコード」または「ID/電話番号」から検索できます。
                                        .account
                                            .dl
                                                .dt
                                                    p アカウントID
                                                .dd
                                                    p ＊＊＊＊＊
                                            .dl
                                                .dt
                                                    p 電話番号
                                                .dd
                                                    a(href="tel:09052460051")
                                                        div
                                                            p 090-5246-0051
                        .stepPanel
                            .ttl
                                .num
                                    p.span STEP
                                    p.em 02
                                h3 お車と車検証を画像を撮影ください。
                            .cntBody
                                .listBox
                                    .ul
                                        .li
                                            .photo
                                                img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/contact_sec02_list_01.png", alt="")
                                            p フロント画像（斜めから）
                                        .li
                                            .photo
                                                img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/contact_sec02_list_02.png", alt="")
                                            p リア画像（斜めから）
                                        .li
                                            .photo
                                                img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/contact_sec02_list_03.png", alt="")
                                            p ハンドル周辺
                                        .li
                                            .photo
                                                img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/contact_sec02_list_04.png", alt="")
                                            p シート周辺
                                        .li
                                            .photo
                                                img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/contact_sec02_list_05.png", alt="")
                                            p 車検証および登録事項証明
                                        .li
                                            .photo
                                                img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/contact_sec02_list_06.png", alt="")
                                            p その他
                        .stepPanel
                            .ttl
                                .num
                                    p.span STEP
                                    p.em 03
                                h3 お車と車検証を画像を撮影ください。
                            .cntBody
                                .docBox01
                                    .photoBox
                                        .photo
                                            img(src="https://garage-egear231127.smooooth.jp/system_panel/uploads/images/contact_sec02_phone.png", alt="")
                                    .txtBox
                                        .dl
                                            .dt
                                                p 車検証をご確認の上、下記項目をお伝えください。
                                            .dd
                                                .ul
                                                    .li
                                                        p □ 車名
                                                    .li
                                                        p □ 年式
                                                    .li
                                                        p □ グレード
                                                    .li
                                                        p □ 走行距離
                                                    .li
                                                        p □ ボディーカラー
                                                    .li
                                                        p □ 装備・オプション
                                                .ul
                                                    .li
                                                        p □ ハンドル右・左
                                                    .li
                                                        p □ 車両状態
                                                    .li
                                                        p □ 登録番号
                                                    .li
                                                        p □ 車台番号
                                                    .li
                                                        p □ 自動車税本年度未納 有無
                                .docBox02
                                    .dl
                                        .dt
                                            p 上記内容を確認後、査定結果をご案内いたします。
                                        .dd
                                            .txt
                                                p 【注意点】
                                                p ※1.LINE電話でのお問い合わせは対応しておりません。
                                                p ※2.お申込み頂いた時間によっては対応が遅れる場合がございます。
                                                p ※3.査定額は概算となります。相場によって査定額は日々変動いたします。
                                                p ※4.査定結果は営業時間内での返信となります。
                                                p ※5.実物を拝見させていただいてからの返信になる車輌がございます。
// △メイン△