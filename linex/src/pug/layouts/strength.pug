// ▽メイン▽
main#strengthMain
	.pageKvPanel
		.pageKvTitle
			.imgTitle
				img(src=(root_path || '') + "image/strength/kv_title.png", alt="Our Strength")
			h1 LINEXの5つの強み
	.topPanel
		.message.fadeUp
			p 付加価値の高い挑戦を続ける<br>最強のパートナーとして
	.secPanelList
		.secPanel01.secPanel
			.secTtlBox
				p On-Site Power
				h2 現場力
			.secBox
				.txtBox
					.txt
						p 「こんなのあったらいいな…」をカタチにする<br>時代の変化を見極めて、<br>常に新しいことに挑戦・進化し続ける「現場力」
				.numBox
					.num
						img(src=(root_path || '') + "image/strength/sec_num_01_pc.png", class="switch", alt="")
		.secPanel02.secPanel
			.secTtlBox
				p Human Power
				h2 人間力
			.secBox
				.txtBox
					.txt
						p 「いないと困る…」と言われ続ける<br>判断力と責任感に優れた人材を育成し、<br>常にお客様と向き合い、お客様第一主義を貫く「人間力」
				.numBox
					.num
						img(src=(root_path || '') + "image/strength/sec_num_02_pc.png", class="switch", alt="")
		.secPanel03.secPanel
			.secTtlBox
				p Proposal Ability
				h2 提案力
			.secBox
				.txtBox
					.txt
						p 「そんなこと…」まで考える<br>柔軟な発想力と高度な技術力を持つスペシャリストが、<br>最善で、最良な方向に導く「提案力」
				.numBox
					.num
						img(src=(root_path || '') + "image/strength/sec_num_03_pc.png", class="switch", alt="")
		.secPanel04.secPanel
			.secTtlBox
				p Hyper Response
				h2 対応力
			.secBox
				.txtBox
					.txt
						p 「本当にできるの…」をやり遂げる<br>お客様の多様なニーズやお困りごとに、<br>方法論から考え、迅速にお応えする「対応力」
				.numBox
					.num
						img(src=(root_path || '') + "image/strength/sec_num_04_pc.png", class="switch", alt="")
		.secPanel05.secPanel
			.secTtlBox
				p Strongest Partner
				h2 最強パートナー
			.secBox
				.txtBox
					.txt
						p 「こいつらなら…」と期待される<br>お客様にとって良いものだけを、次々と新規事業化する。<br>付加価値の高い、挑戦をし続ける「最強パートナー」
				.numBox
					.num
						img(src=(root_path || '') + "image/strength/sec_num_05_pc.png", class="switch", alt="")
// △メイン△