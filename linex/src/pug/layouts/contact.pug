main#contactMain
    .pageKvPanel
        .pageKvTitle
            .imgTitle
                img(src=(root_path || '') + "image/contact/kv_title.png", alt="contact Profile")
            h1 お問い合わせ
    .formContainer
        .secWrap01
            .topTxt
                p 下記フォームに必要事項をご記入の上、<br class="spBreak">お問い合わせください。
            .formBox
                form
                    .nameBox
                        dl
                            dt
                                span 姓(漢字)
                                em ※
                            dd
                                .inputBox
                                    input(type="text")
                        dl
                            dt
                                span 名(漢字)
                                em ※
                            dd
                                .inputBox
                                    input(type="text")
                    .nameBox
                        dl
                            dt
                                span 姓(カナ)
                                em ※
                            dd
                                .inputBox
                                    input(type="text")
                        dl
                            dt
                                span 名(カナ)
                                em ※
                            dd
                                .inputBox
                                    input(type="text")
                    dl
                        dt
                            span メールアドレス
                            em ※
                        dd
                            .inputBox
                                input(type="email")
                    dl
                        dt
                            span メールアドレス(確認)
                            em ※
                        dd
                            .inputBox
                                input(type="email")
                    dl.msg
                        dt
                            span お問い合わせ内容
                            em ※
                        dd
                            .inputBox
                                textarea
                    .submitButton
                        <input type="submit" value="確認画面へ" class="wpcf7-form-control has-spinner wpcf7-submit"/>
