// ▽メイン▽
main#businessMain
	.pageKvPanel
		.pageKvTitle
			.imgTitle
				img(src=(root_path || '') + "image/business/kv_title.png", alt="Business")
			h1 事業内容
	.introContainer
		.introPanel
			.title01
				img(src=(root_path || '') + "image/business/intro_title_01.png", alt="")
			.title02
				h2 個人でお住いのお客様から、<br>法人を営まれるお客様まで。
			.imgBox
				img(src=(root_path || '') + "image/business/intro_img_01.png", alt="")
			.txt
				p お客様のこだわりをとことん、お聞かせください。<br>お客様のニーズをさらに膨らませた<br>エクステリアを企画提案から設計、外構・造園工事までを<br>トータルにコーディネートします。
				p お客様ごとのスタイルの違い、建物と敷地の違いを、<br>空間から景観まで深く考えた上で、<br>機能性とデザイン性が備わった数々のアイテムを組み合わせて、<br>ご満足いただけるイメージを創出します。<br>センスと使いやすさをこだわればこだわるほど、<br>そのエクステリアは、お客様そのものを表現してくれます。
		.mv
			img(src=(root_path || '') + "image/business/intro_mv_01.png", alt="")
	.introContainer
		.introPanel
			.title01
				img(src=(root_path || '') + "image/business/intro_title_02.png", alt="")
			.title02
				h2 エクステリア商材の<br>販売から輸送。
			.imgBox
				img(src=(root_path || '') + "image/business/intro_img_01.png", alt="")
			.txt
				p ハウスメーカー様や外構工事業者様向けに、カーポートや物置、<br>フェンスや石材等のエクステリア商材の販売から輸送をはじめ、<br>設計から外構・造園工事までをトータルにサポートします。
		.mv
			img(src=(root_path || '') + "image/business/intro_mv_02.png", alt="")
	.listContainer
		.secTtl
			h2 施工事例
		.listBox
			ul
				li
					.photo
						img(src=(root_path || '') + "image/business/list_01.png", alt="")
					.comment
						p コメント
				li
					.photo
						img(src=(root_path || '') + "image/business/list_01.png", alt="")
					.comment
						p コメント
				li
					.photo
						img(src=(root_path || '') + "image/business/list_01.png", alt="")
					.comment
						p コメント
