                                .dl
                                    .dt
                                        p.span お名前
                                        p.em 必須
                                    .dd
                                        input(type="text" class="name" name="お名前" placeholder="例）蓮沼　太郎" data-displaynameattr="お名前").validateRequired
                                .dl
                                    .dt
                                        p.span フリガナ
                                        p.em 必須
                                    .dd
                                        input(type="text" class="kana" name="フリガナ" placeholder="例）ハスヌマ　タロウ" data-displaynameattr="フリガナ").validateRequired
                                .dl
                                    .dt
