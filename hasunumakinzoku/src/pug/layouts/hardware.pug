					.li
						.img
							img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_sec03_img_02.png", alt="")
						p 笠木
					.li
						.img
							img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_sec03_img_03.png", alt="")
