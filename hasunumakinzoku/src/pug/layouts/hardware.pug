// ▽メイン▽
.businessMain.main
	.pageKvContainer
		.pageKvPanel
			.pageKvTitle
				.sub
					p HARDWARE
				.title
					h1 金物事業
			.pageKvPhoto
				img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_kv.png", alt="")
	.sec01.section
		.secWrap01
			.pageSecTtlBox
				.subTtl
					p.em H
					p ardware
				.secTtl
					h2 金物事業
			.secBoxList
				.secBox
					.photo
						img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_sec01_top_img.png", alt="")
					.txtBox
						.dl
							.dt
								p お客様の安心を守るために<br>蓮沼金属は1ｍｍの誤差も妥協しません
							.dd
								.txt
									p オフィスビルや学校、病院などの施設を対象として、お客さまの安全を守るための金属製部位の設置工事を行っています。<br>経験豊富な職人が正確に採寸し、その建物にあった施工を考え、柔軟に対応。<br>お客様の安心を第一に考え、1mmの誤差も妥協しません。<br>全国での施工実績がありますので、県外の建設現場もお気軽にご依頼ください。
			.worksPanel
				.titleBox
					.title
						p.em 施工
						p 実績
				.txt
					p 公共事業：新潟駅・各種老人ホーム・学校・下水処理場・公営住宅<br>その他：マンション・銀行・ホテル
	.requestSection
		.mvContainer
			.secWrap01
				.secTtl
					h2 急なご依頼も受け付けます
				.txt
					p 全国出張承っております。<br>急ぎの場合も対応できることがあるので、<br>下記よりお電話またはメールでお問い合わせください。
		.contactContainer
			.secWrap01
				.contactPanel
					.listBox
						.telBox
							.ttl
								p お急ぎの方はこちらから
							.telLink
								a(href="tel:0256787323")
									div
										p.span tel.
										p.em 0256-78-7323
								p 受付時間　　平日9：00 ～ 16：00
						.mailBox
							.ttl
								p お見積りなどのご相談はメールから
							.btnMail
								a(href="contact")
									div
										p メールフォームへ
	.sec02.section
		.secWrap01
			.pageSecTtlBox
				.subTtl
					p.em S
					p trength
				.secTtl
					h2 金物事業の強み
			.secBoxList
				.secBox
					.photo
						img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_sec02_img_01.png", alt="")
					.txtBox
						.dl
							.dt
								p 豊富な経験や知識をもとに<br>多様な現場に対応します
							.dd
								.txt
									p 金物取付は現場ごとに必要なものや形、大きさが様々で、施工方法も多様です。<br>蓮沼金属には経験豊富なスタッフが在籍しています。<br>これまで培ってきた経験や技術、知識をもとに建物ごとに最適な施工方法を導き、1ｍｍの誤差もなく仕上げます。
				.secBox
					.photo
						img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_sec02_img_02.png", alt="")
					.txtBox
						.dl
							.dt
								p マンションから商業ビルまで<br>全国のあらゆる建物に対応します
							.dd
								.txt
									p 蓮沼金属では首都圏を中心に全国の多様な建設現場の施工を請け負ってきました。<br>学校、病院などの施設から商業ビルなど幅広い建物の施工実績があります。<br>全国のあらゆる建物の施工を承っていますので、お気軽にお問い合わせください。
