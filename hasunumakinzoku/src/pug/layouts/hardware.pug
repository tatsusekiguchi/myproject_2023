					.li
						.img
							img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_sec03_img_04.png", alt="")
						p スパンドレール
					.li
						.img
							img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_sec03_img_05.png", alt="")
						p ルーバー
					.li
						.img
							img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/hardware_sec03_img_06.png", alt="")
