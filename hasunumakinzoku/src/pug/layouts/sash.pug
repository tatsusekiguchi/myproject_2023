// ▽メイン▽
.businessMain.main
	.pageKvContainer
		.pageKvPanel
			.pageKvTitle
				.sub
					p SASH
				.title
					h1 サッシ事業
			.pageKvPhoto
				img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/sash_kv.png", alt="")
	.sec01.section
		.secWrap01
			.pageSecTtlBox
				.subTtl
					p.em S
					p ash
				.secTtl
					h2 サッシ事業
			.secBoxList
				.secBox
					.photo
						img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/sash_sec01_top_img.png", alt="")
					.txtBox
						.dl
							.dt
								p オフィスビルや病院など施工実績多数。<br>サッシ工事は蓮沼金属にお任せください。
							.dd
								.txt
									p 蓮沼金属では、生活に欠かせない施設を中心にサッシ工事をしています。<br>サッシのほかスチール扉や防火扉の取付工事を承っております。<br>施工完了後もずっと快適に使っていただけるように。<br>いざとなった時にしっかり機能するように。<br>1mmの誤差も見逃さないよう、精密な施工を心がけています。<br>大規模工事や全国出張も対応していますので、お問い合わせください。
			.worksPanel
				.titleBox
					.title
						p.em 施工
						p 実績
				.txtList
					.txtBox
						.txt
							p 新潟県庁(知事室の扉の入替工事など)<br>エコスタジアム(各出入り口の鉄製扉)<br>新潟市民病院(新館)
					.txtBox
						.txt
							p 朱鷺メッセコンベンションホール<br>NST(各スタジオの入口)<br>銀座マリオン
					.txtBox
						.txt
							p NEXT21(エスカレーター脇のガラスの枠)<br>長野県　Uスタジアム(サッカー場)<br>長野県　NHK
				.aside
					p 田中サッシュ工業株式会社のもと
	.requestSection
		.mvContainer
			.secWrap01
				.secTtl
					h2 急なご依頼も受け付けます
				.txt
					p 全国出張承っております。<br>急ぎの場合も対応できることがあるので、<br>下記よりお電話またはメールでお問い合わせください。
		.contactContainer
			.secWrap01
				.contactPanel
					.listBox
						.telBox
							.ttl
								p お急ぎの方はこちらから
							.telLink
								a(href="tel:0256787323")
									div
										p.span tel.
										p.em 0256-78-7323
								p 受付時間　　平日9：00 ～ 16：00
						.mailBox
							.ttl
								p お見積りなどのご相談はメールから
							.btnMail
								a(href="contact")
									div
										p メールフォームへ
	.sec02.section
		.secWrap01
			.pageSecTtlBox
				.subTtl
					p.em S
					p trength
				.secTtl
					h2 サッシ事業の強み
			.secBoxList
				.secBox
					.photo
						img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/sash_sec02_img_01.png", alt="")
					.txtBox
						.dl
							.dt
								p この道4０年。<br>熟練の職人があらゆる現場に対応します。
							.dd
								.txt
									p 40年以上の経験がある実績豊富な職人が丁寧に施工します。<br>オフィスビル、病院、学校、ドームなど多様な建物の取付実績があります。<br>あらゆる現場で臨機応変に対応いたしますので、安心してお任せいただけます。
				.secBox
					.photo
						img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/sash_sec02_img_02.png", alt="")
					.txtBox
						.dl
							.dt
								p 全国対応可能。<br>県外の場合もご相談ください。
							.dd
								.txt
									p これまで首都圏を中心に大阪、新潟、福岡、横浜、仙台など全国のビル建設現場で施工してきました。<br>新潟県内はもちろん、全国のお客様もお気軽にお問い合わせください。
	.sec03.section
		.secWrap01
			.pageSecTtlBox
				.subTtl
					p.em W
					p orks
				.secTtl
					h2 対応可能なサッシ工事
			.listBox
				.ul
					.li
						.img
							img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/sash_sec03_img_01.png", alt="")
						p サッシ
					.li
						.img
							img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/sash_sec03_img_02.png", alt="")
						p 防火扉
					.li
						.img
							img(src="https://hasunuma-metal.co.jp/system_panel/uploads/images/sash_sec03_img_03.png", alt="")
						p スチールドア
			.btnMore
				a(href="workslist")
					div
						p 施工事例をもっと見る
