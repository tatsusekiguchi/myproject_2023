// ▽メイン▽
.recruitMain.main
    .pageKv
        .kvWrap
            .kvBox
            .kvTtlBox
                h1.fadeUp RECRUIT
                p.fadeUp 採用情報
    .sec01
        .secWrap01
            .secTtl.fadeUp
                .ttl
                    .img
                        img(src="https://compassion210817.smooooth.jp/system_panel/uploads/images/recruit_ttl_01.png", alt="")
                h2 メッセージ
            .secBoxWrap
                .secBox.fadeLeft
                    h3 一人ひとりが主人公
                    p どんな人生であろうと、人生の主役は自分です。<br>それはスポットライトを周りから当ててもらうのではなく、<br>自分で照らすことだと思います。<br>自分の人生であり、他人と比較できるものではありません。<br>だからこそ、たくさんのことを経験して様々な思いを感じることが大切です。<br>失敗を恐れず挑戦したり、やってみて後悔したり。<br>そのたくさんの失敗や思いこそが、次へのステップアップに繋がります。<br>スタッフが思ったことややりたいことを応援する、<br>自由に挑戦できる環境がコンパッションにはあります。<br>みんなが主人公の会社で、ぜひ一緒に働きませんか？
    .sec02
        .secWrap02
            .secTtl.fadeUp
                .ttl
                    .img
                        img(src="https://compassion210817.smooooth.jp/system_panel/uploads/images/recruit_ttl_02.png", alt="")
                h2 求める人材
            .ul.fadeLeft
                .li
                    p 常に成長しようとする<br>意志がある
                .li
                    p チャレンジ精神<br>がある
                .li
                    p 思いやる心を<br>大切にできる
            .moreLink
                a(href="staff").more.orange
                    div
                        p 働く仲間をみてみよう！
    .sec03
        .secWrap03
            .secTtl.fadeUp
                .ttl
                    .img
                        img(src="https://compassion210817.smooooth.jp/system_panel/uploads/images/recruit_ttl_03.png", alt="")
                h2 流れ
            .ol.fadeLeft
                .li
                    .step
                        p STEP
                    .num
                        p 01
                    .txt
                        p エントリー
                .li
                    .step
                        p STEP
                    .num
                        p 02
                    .txt
                        p 書類選考
                .li
                    .step
                        p STEP
                    .num
                        p 03
                    .txt
                        p 面接
                .li
                    .step
                        p STEP
                    .num
                        p 04
                    .txt
                        p 内定連絡
                .li
                    .step
                        p STEP
                    .num
                        p 05
                    .txt
                        p 入社
    .sec04
        .secWrap03
            .secTtl.fadeUp
                .ttl
                    .img
                        img(src="https://compassion210817.smooooth.jp/system_panel/uploads/images/recruit_ttl_04.png", alt="")
                h2 募集要項
            .infoBox.fadeUp
                .dl
                    .dt
                        p 募集職種
                    .dd
                        p ドライバー・運転手、配達・配送・宅配便、軽作業・物流
                .dl
                    .dt
                        p 雇用形態
                    .dd
                        p 正社員<br>※試用期間：３か月
                .dl
                    .dt
                        p 勤務時間
                    .dd
                        p ①04：00～15：00<br>②10：00～18：00<br>実働8時間　休憩１時間
                .dl
                    .dt
                        p 条件
                    .dd
                        p 未経験者歓迎<br>※２ｔトラック以上が運転できる方
                .dl
                    .dt
                        p 仕事内容
                    .dd
                        p ①住宅資材配送のお仕事<br>配送エリア…横浜/川崎/目黒区/大田区/世田谷区エリア<br>勤務時間…04:00~15:00<br>②日用品や生活雑貨の配送<br>配送エリア…世田谷区<br>勤務時間…10:00~18:00
                .dl
                    .dt
                        p 勤務地
                    .dd
                        p 市川営業所<br>千葉県市川市北方町4-1834-19（最寄駅：船橋法典駅）
                .dl
                    .dt
                        p 給与
                    .dd
                        p ①月給30万円～<br>②月給27万円～<br>■昇給あり(4月)<br>■賞与あり（業績による）<br>■残業代別途支給
                .dl
                    .dt
                        p 休日
                    .dd
                        p 年間休日１２０日<br>休　　日：週休２日制　土・日・祝日<br>長期休暇：年末年始・夏季休暇
                .dl
                    .dt
                        p 福利厚生
                    .dd
                        p 雇用保険<br>厚生年金<br>労災保険<br>健康保険<br>交通費支給あり<br>資格取得支援・手当てあり<br>マイカー・バイク・自転車通勤OK<br>制服貸与<br>社員旅行あり
    .sec05
        .secWrap03
            .secTtl.fadeUp
                .ttl
                    .img
                        img(src="https://compassion210817.smooooth.jp/system_panel/uploads/images/recruit_ttl_05.png", alt="")
                h2 応募フォーム
            p 下記の応募フォームより、ご応募ください。<br>必要事項を記入の上【応募する】ボタンをクリック下さい。
            .contactForm.fadeUp
                form(data-formtype="1" method="post").form
                    .formBox
                        .dl
                            .dt
                                p.span お名前
                                p.em 必須
                            .dd
                                input(type="text" class="name" name="name" placeholder="例）山田 太郎" data-displaynameattr="お名前" required)
                        .dl
                            .dt
                                p.span ふりがな
                                p.em 必須
                            .dd
                                input(type="text" class="kana" name="kana" placeholder="例）やまだ たろう" data-displaynameattr="ふりがな" required)
                        .dl.ageInput
                            .dt
                                p.span 年齢
                                p.em 必須
                            .dd
                                input(type="text" class="ageTxt" name="ageTxt" data-displaynameattr="年齢" required)
                                p.span 歳
                        .dl.postal
                            .dt
                                p.span 郵便番号
                                p.em 必須
                            .dd
                                input(type="text" class="postal_01 zip1" name="postal_01" data-displaynameattr="郵便番号上3桁"  placeholder="例）272" required)
                                p.span -
                                input(type="text" class="postal_02 zip2" name="postal_02" data-displaynameattr="郵便番号下4桁" placeholder="0815" required)
                        .dl
                            .dt
                                p.span 住所
                                p.em 必須
                            .dd
                                input(type="text" class="address01" name="address01" placeholder="例） 千葉県市川市北方町4-1834-19" data-displaynameattr="住所" required)
                        .dl
                            .dt
                                p.span 電話番号
                                p.em 必須
                            .dd
                                input(type="tel" class="tel" name="tel" placeholder="例） 03-6638-6907" data-displaynameattr="電話番号" required)
                        .dl
                            .dt
                                p.span メールアドレス
                                p.em 必須
                            .dd
                                input(type="email" class="mail" name="mail" placeholder="例） compassion＠com" data-displaynameattr="メールアドレス" required)
                        .dl
                            .dt
                                p.span メールアドレス（確認用）
                                p.em 必須
                            .dd
                                input(type="email" class="mailConfirm" name="mailConfirm" placeholder="確認のため再度お願いいたします。" data-displaynameattr="メールアドレス（確認用）" required)
                        .dl.formTopItem
                            .dt
                                p.span 経験の有無
                            .dd.radioList
                                .list
                                    .radioBox
                                        .radio
                                            input(type="radio" class="checkExp" name='checkExp' value="未経験" data-displaynameattr="経験の有無")
                                            label 未経験
                                .list
                                    .radioBox
                                        .radio
                                            input(type="radio" class="checkExp" name='checkExp' value="1～5年" data-displaynameattr=" 経験の有無")
                                            label 1～5年
                                .list
                                    .radioBox
                                        .radio
                                            input(type="radio" class="checkExp" name='checkExp' value="6年以上" data-displaynameattr=" 経験の有無")
                                            label 6年以上
                        .dl.formTopItem
                            .dt
                                p.span ご質問
                            .dd
                                textarea(name="ご質問" class="msg" placeholder="お気軽にご質問ください。" data-displaynameattr="ご質問")
                    .privacy
                        .infoTel
                            a(href="tel:0366386907")
                                div
                                    p ※3営業日以内に返信がない場合はお電話下さい。
                        .agreeBox
                            p 個人情報の取り扱いについて
                            p 株式会社コンパッションでは個人情報を適切に管理運用するための基本的事項を定めています。<br>・個人情報の利用目的<br>個人情報は当社からご連絡する目的のためのみに取得し、取得した個人情報については不正利用・紛失・破壊・改ざん、<br>および漏えいに対し適切な予防ならびに是正に関する措置を適切に講じます。<br>・個人情報の第三者への開示・提供の禁止<br>お客様の個人情報について、お客様の承諾が無い限り第三者に開示、提供を一切いたしません。 ご提供いただいた個人情報を取り扱うにあたり管理責任者を置き、適切な管理を行っております。<br>・ご本人の照会<br>個人情報の照会・修正・削除などをご希望される場合には、ご本人であることを確認の上対応させていただきます。<br>・法令、規範の遵守と見直し<br>保有する個人情報について日本の法令その他規範を遵守するとともに、本規約の内容を適宜見直しその改善に努めます。
                            p 本ポリシーに関するお問い合わせは，下記の窓口までお願いいたします。
                            p 会社名：株式会社コンパッション
                            p 住所：東京都江戸川区江戸川2丁目3番地13
                            .tel
                                p 電話番号：
                                a(href="tel:0366386907")
                                    div
                                        p 03-6638-6907
                    .agreeCheck
                        .checkBox
                            label 
                                input(type="checkbox")
                                span 個人情報の取り扱いについて同意する
                    .submitBtn
                        button(type="submit") 応募する
// △メイン△
script(src="../js/jquery.jpostal.js")
script(src="../js/formRecruit.js")