meta(charset='UTF-8')
meta(http-equiv='X-UA-Compatible', content='IE=edge')
meta(name='viewport', content='width=device-width,initial-scale=1.0,minimum-scale=1.0')
meta(name='format-detection', content='telephone=no')
meta(name='description', content=description)
meta(name='keywords', content=keywords)
// css
link(rel='stylesheet', type="text/css", href=(root_path || '') + 'css/reset.css')
link(rel='stylesheet', href=(root_path || '') + 'css/slider-pro.css')
link(rel='stylesheet', type="text/css", href=(root_path || '') + 'css/fullpage.css')
link(rel='stylesheet', type="text/css", href=(root_path || '') + 'css/common.css')
link(rel='stylesheet', type="text/css", href=(root_path || '') + 'css/layout.css')
link(rel='stylesheet', href=(root_path || '') + 'css/animate.css')
link(rel='stylesheet', type="text/css", href=(root_path || '') + 'css/common_sp.css')
link(rel='stylesheet', type="text/css", href=(root_path || '') + 'css/layout_sp.css')
// js
script(src=(root_path || '') + 'js/jquery-1.11.3.min.js')
script(src=(root_path || '') + 'js/infiniteslide.js')
script(src=(root_path || '') + 'js/common.js')
script(src=(root_path || '') + 'js/scrollAnimation.js')
if page_name == 'top'
  script(src=(root_path || '') + 'js/jquery-scrolloverflow.min.js')
  script(src=(root_path || '') + 'js/jquery.fullpage.min.js')
  script(src=(root_path || '') + 'js/jquery.sliderPro.min.js')
  //script(src=(root_path || '') + 'js/slideText.js')
  script(src=(root_path || '') + 'js/top.js')
//- layout_js が定義されている場合に挿入
if layout_js
  each js_path in layout_js
    script(src=(root_path || '') + js_path)
// title
title #{title}
