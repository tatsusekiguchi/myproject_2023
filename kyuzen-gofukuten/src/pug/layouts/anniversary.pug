// ▽メイン▽
.anniversaryMain.main.serviceMain
    .pageKvPanel
        .pageKvTtl
            h1 大人の記念写真
    .featureSection
        .secWrap01
            .pageSecTtlBox
                h2 スタジオKYUZENの特徴
                p Features
            .secBoxList
                .secBox
                    .ttlBox
                        h3 遺影の生前撮影なら<br>スタジオKYUZEN
                        p 大切な人に自分らしい笑顔を残したい。
                    .photo
                        img(src="https://studio-kyuzen.jp/system_panel/uploads/images/anniversary_feature_img_01.png", alt="")
                    .txt.gothic
                        p 若かりし頃の思い出の品や服装、趣味の物と一緒に遺影撮影しませんか？<br>小物や衣装であなたらしさを演出しましょう。<br>長寿のお祝いのタイミングで記念撮影を兼ねて撮影されたり、毎年同じ日に写真を更新するイベントとして楽しまれる方もおられます。<br>お気に入りの装いで、素敵な笑顔を残しましょう。
                .secBox
                    .ttlBox
                        h3 ご家族の皆様とのお祝いを写真に
                        p さりげない毎日が家族の記念日。
                    .photo
                        img(src="https://studio-kyuzen.jp/system_panel/uploads/images/anniversary_feature_img_02.png", alt="")
                    .txt.gothic
                        p スタジオKYUZENではお母様やお父様娘様やお子様などを含んだ複数名での撮影も承っております。<br>還暦・古希・米寿など長寿の記念撮影やご夫婦の結婚記念日やご家族の記念日など人生の節目に写真を残しませんか？<br>家族みんなが主役になれる、表情豊かな一枚をお撮りいたします。<br>ご本人以外の方への着物、衣装のレンタルも行っておりますのでお気軽にご相談ください。
    .planSection
        .secWrap01
            .pageSecTtlBox
                h2 撮影プラン
                p Plan
            .basicBox
                .ttlBox
                    p.em 基本料金：55,000
                    p.span 円(税込)
                .txtBox
                    .txt
                        p □内容
                        p スタジオ撮影　2カット台紙　ヘアメイク　画像加工　L版写真1枚　DVD データ
                        .aside
                            p ※その他、ロケーション撮影や家族写真なども可能です。
                            p お気軽にご相談ください。
    .rentalSection.rentalAnniversary
        .secWrap01
            .pageSecTtlBox
                h2 着物・衣装レンタル
                p Rental
            .secBox
                h3 レンタル着物
                .photo
                    img(src="https://studio-kyuzen.jp/system_panel/uploads/images/anniversary_rental_img_01.png", alt="")
                .listBox.gothic
                    .ul
                        .li
                            p 訪問着
                        .li
                            p 33,000円( 税込) ～
                    .ul
                        .li
                            p 黒留袖
                        .li
                            p 38,500円( 税込) ～
                    .ul
                        .li
                            p 色留袖
                        .li
                            p 44,000円( 税込)
                    .ul
                        .li
                            p 色無地
                        .li
                            p 33,000円( 税込)
    .caseSection
        .pageSecTtlBox
            h2 撮影事例
            p Photocut
        .swiperContainer
            .swiper-wrapper
                .swiper-slide
                    img(src="https://studio-kyuzen.jp/system_panel/uploads/images/anniversary_case_img_01.png", alt="")
                .swiper-slide
                    img(src="https://studio-kyuzen.jp/system_panel/uploads/images/anniversary_case_img_02.png", alt="")
                .swiper-slide
                    img(src="https://studio-kyuzen.jp/system_panel/uploads/images/anniversary_case_img_03.png", alt="")
                .swiper-slide
                    img(src="https://studio-kyuzen.jp/system_panel/uploads/images/anniversary_case_img_04.png", alt="")
