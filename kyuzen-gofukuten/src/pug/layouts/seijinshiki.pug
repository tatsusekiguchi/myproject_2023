                    .li
                        .icon
                            img(src="https://studio-kyuzen.jp/system_panel/uploads/images/service_flow_icon_03.png", alt="")
                        .ttl
                            p 鹿島神宮<br>到着
                    .li
                        .icon
                            img(src="https://studio-kyuzen.jp/system_panel/uploads/images/service_flow_icon_04.png", alt="")
                        .ttl
                            p 撮影開始
                    .li
                        .icon
                            img(src="https://studio-kyuzen.jp/system_panel/uploads/images/service_flow_icon_05.png", alt="")
                        .ttl
