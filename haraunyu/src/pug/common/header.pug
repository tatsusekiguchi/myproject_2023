// ▽header▽
.header
    .headWrap
        .logoBox
            p 全国へ「想い」を届ける、関東・茨城の運送会社
            .logo
                a(href="/")
                    div
                        img(src="https://haraunyu.co.jp/system_panel/uploads/images/header_logo.png", alt="")
            .snsList
                .sns
                    a(href="https://www.instagram.com/hara_transport/?hl=el", target="_blank", rel="noopener")
                        div
                            img(src="https://haraunyu.co.jp/system_panel/uploads/images/header_insta.png", alt="")
                .sns
                    a(href="#", target="_blank", rel="noopener")
