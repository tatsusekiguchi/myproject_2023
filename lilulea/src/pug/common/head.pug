meta(charset='UTF-8')
meta(http-equiv='X-UA-Compatible', content='IE=edge')
meta(name='viewport', content='width=device-width,initial-scale=1.0,minimum-scale=1.0')
meta(name='format-detection', content='telephone=no')
meta(name='description', content=description)
meta(name='keywords', content=keywords)
// css
link(rel='stylesheet', href=(root_path || '') + 'css/reset.css')
link(rel='stylesheet', href=(root_path || '') + 'css/animate.css')
link(rel='stylesheet', href=(root_path || '') + 'css/validationEngine.css')
link(rel='stylesheet', href=(root_path || '') + 'css/common.css')
link(rel='stylesheet', href=(root_path || '') + 'css/layout.css')
link(rel='stylesheet', media='screen and (max-width: 1024px)', type='text/css', href=(root_path || '') + 'css/common_sp.css')
link(rel='stylesheet', media='screen and (max-width: 1024px)', type='text/css', href=(root_path || '') + 'css/layout_sp.css')
link(rel='stylesheet', href=(root_path || '') + 'css/attach.css')
// js
script(src=(root_path || '') + 'js/jquery-1.11.3.min.js')
script(src=(root_path || '') + 'js/common.js')
script(src=(root_path || '') + 'js/scrollAnimation.js')
script(src=(root_path || '') + 'js/validate.js')
script(src=(root_path || '') + 'js/validateJa.js')
script(src=(root_path || '') + 'js/jpostal.js')
script(src=(root_path || '') + 'js/autokana.js')
script(src=(root_path || '') + 'js/formContact.js')
//- layout_js が定義されている場合に挿入
if layout_js
  each js_path in layout_js
    script(src=(root_path || '') + js_path)
// title
title #{title}
