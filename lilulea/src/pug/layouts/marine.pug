// ▽メイン▽
.marineMain.main
	.pageKvContainer
		.pageKvPanel
			.pageKvTitle
				p MARINE
				h1 マリン事業
	.mainContainer
		.sec01
			.secWrap.fadeUp
				.pageSecTitle
					p SERVICE CONCEPT
					.secTitle
						h2 慌ただしい日常から離れた、<br>自分だけの楽園。
				.txt
					p 慌ただしい日常から一旦離れて、穏やかな空気が流れる南の国で、リラックスした時間を過ごしませんか？<br>ここでは心配することは何もありません。<br>浜辺から海をぼーっと眺めるもよし、思いっきりマリンアクティビティを楽しむもよし、<br>夜は薪を囲んで語らうもよし。<br>思い思いの時間をお過ごしください。
		.sec02
			.secWrap
				.secContainer.fadeUp
					.pageSecTitle
						p SERVICE
						.secTitle
							h2 リルレアリゾートの魅力
					.listBox
						.ol
							.li.fadeUp
								.num
									p 01
								.photo
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec02_img_01.png", alt="")
								.dl
									.dt
										p 楽しみ方いろいろ
									.dd
										p 定番のダイビングから話題のフライボートまで、アクティビティをたっぷりご用意。<br>さらにグランピングやウェディング、介護施設のサービスをご提供。<br>幅広いシーンでお楽しみいただけます。
							.li.fadeUp
								.num
									p 02
								.photo
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec02_img_02.png", alt="")
								.dl
									.dt
										p ここだけの絶景
									.dd
										p 手つかずの大自然が残る奄美大島。<br>どこまでも美しい青の海は、眺めているだけでリラックスできます。<br>ここだけの絶景をゆっくりお楽しみください。
							.li.fadeUp
								.num
									p 03
								.photo
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec02_img_03.png", alt="")
								.dl
									.dt
										p ちょうどいいリゾート
									.dd
										p いわゆる高級リゾートではないけれど、美しい自然の中で、ちょっと贅沢な非日常を味わえる。<br>そんな空間をご用意しています。<br>奄美の楽園で、リラックスしてお過ごしください。
		.sec03
			.secWrap
				.pageSecTitle.fadeUp
					p SERVICE
					.secTitle
						h2 リルレアリゾートでできること
				.secContainer.fadeUp
					.section
						h3 海で遊ぶ
						.txt
							p 今この瞬間に没頭して、思いっきり遊びませんか？<br>遊び終わった頃には頭も体もスッキリしているはず！
						.listBox01.listBox
							.ul
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_1_1.png", alt="")
									p ダイビング
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_1_2.png", alt="")
									p シーカヤック
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_1_3.png", alt="")
									p SUP
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_1_4.png", alt="")
									p ウェイクボード
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_1_5.png", alt="")
									p ジェットスキー
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_1_6.png", alt="")
									p フライボード
				.secContainer.fadeUp
					.section
						h3 海でくつろぐ
						.txt
							p どこまでも広がる海と、波の音に癒されて、チルな時間を過ごしませんか？<br>何もない贅沢が、ここにあります。
						.listBox01.listBox
							.ul
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_2_1.png", alt="")
									p サウナ
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_2_2.png", alt="")
									p グランピング
								.li
									.photo
										img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_2_3.png", alt="")
									p キャンプ
				.secContainer.multi
					.section.fadeUp
						h3 海のそばに暮らす
						.txt
							p あたたかい場所で穏やかに暮らせる場所をご用意しました。<br>海を眺めながら楽しく過ごしませんか？
						.photoBox
							.photo
								img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_3_1.png", alt="")
							p 介護施設
					.section.fadeUp
						h3 海で祝う
						.txt
							p 一生に一度のお祝いは、みんなの記憶に残る場所でしませんか？<br>海ならではの開放的な空気が、一体感を生み出します。
						.photoBox
							.photo
								img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec03_img_4_1.png", alt="")
							p ウェディング
		.sec04
			.secWrap
				.pageSecTitle.fadeUp
					p INFO
					.secTitle
						h2 施設情報
				.secBox.fadeUp
					.photo
						img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/marine_sec04_img.png", alt="")
					.txtBox
						h3 リルレアリゾート
						.infoBox
							.txt
								p ADDRESS/〇〇県〇〇市〇〇〇〇〇〇
								a(href="tel:00000000000")
									div
										p TEL/000-0000-0000
								p OPEN/00:00~00:00
								p ACCESS/〇〇から車で〇分
		.mapContainer
			.mapBox
				<iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d13121.896887625642!2d135.8133485!3d34.6932171!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60013bbbc419d94b%3A0x295e80f085031bd0!2z44G-44Gv44KN!5e0!3m2!1sja!2sjp!4v1696300641926!5m2!1sja!2sjp" allow="fullscreen"></iframe>
