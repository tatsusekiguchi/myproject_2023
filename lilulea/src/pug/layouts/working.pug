// ▽メイン▽
.workingMain.main
	.pageKvContainer
		.pageKvPanel
			.pageKvTitle
				p WORKING ENVIRONMENT
				h1 働く環境
	.mainContainer
		.sec01
			.secWrap
				.pageSecTitle.fadeUp
					p WORKING ENVIRONMENT
					.secTitle
						h2 働くお母さんに優しい環境です。
				.topTxt.fadeUp
					p もちろん男性も大歓迎です！
				.secContainer.fadeUp
					.secBox
						.photo
							img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/working_sec01_img.png", alt="")
						.txtBox
							.dl
								.dt
									p 安心のバックアップ体制
								.dd
									p 誰かが急に休んでも、代わりのスタッフが入れる体制を整えています。<br>お子さんの熱や急な用事が入ったときも、気兼ねなく休むことができます。
							.dl
								.dt
									p 柔軟なシフト制
								.dd
									p 日勤や夜勤などの固定のシフトではなく、働き方によって柔軟にシフトを組むことができます。<br>週に何日働きたい、何時から何時まで働きたい、というご希望に合わせて対応します。<br>ご自身の生活スタイルに合わせた働き方を実現できます。
							.dl
								.dt
									p プライベート時間を確保
								.dd
									p プライベートを大切にしてほしいので、時間外の会議や懇親会は基本ありません。<br>必要な会議や共有は勤務時間内に行います。<br>懇親会はありませんが、その分日頃の会話やコミュニケーションは大切にしています。
		.sec02
			.secWrap01
				.pageSecTitle.fadeUp
					p MESSAGE
					.secTitle
						h2 先輩の声
				.secContainer
					.voicePanel.fadeUp
						.photo
							img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/working_sec02_img_01.png", alt="")
						.txtBox
							.dl
								.dt
									p 「ありがとう」が励みになる
								.dd
									p この仕事をしていてやりがいを感じるのは「ありがとう」と言ってもらえる時です。<br>自分にとっては何でもないことでも、ご利用者さんにとってはありがたいことが多い仕事です。<br>一日に何十回と感謝の言葉をもらえるのは、この仕事の特権だと思います。
					.voicePanel.fadeUp
						.photo
							img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/working_sec02_img_02.png", alt="")
						.txtBox
							.dl
								.dt
									p 子ども優先で働ける
								.dd
									p 子どもの体が弱く、他の職場では迷惑がかかるので働き続けるのが難しいと感じていました。<br>この職場ではバックアップ体制が整っているので、安心して代わりのスタッフに任せることができます。<br>子どもを優先しながらも、介護の仕事を続けられる環境にとても感謝しています。
		.sec03
			.secWrap
				.pageSecTitle.fadeUp
					p TIME SCHEDULE
					.secTitle
						h2 一日の流れ
				.txt.fadeUp
					p 起床から就寝まで、シフト制で日常生活の介助をします。<br>一人のご利用者さんを担当することもあれば、近隣のご利用者さんを複数担当することもあります。
				.schedulePanel.fadeUp
					.ul
						.li
							p 起床介助
						.li
							p トイレ介助
						.li
							p 食事介助
						.li
							p トイレ介助
						.li
							p 食事介助
						.li
							p 入浴介助
						.li
							p 就寝介助
				.workplaceContainer.fadeUp
					.ttl
						p 先輩の職場にちょっとだけお邪魔しました
					.secBox
						.photo
							img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/working_sec03_workplace_img.png", alt="")
						.txtBox
							.dl
								.dt
									p 送迎の介助
								.dd
									p 病院などの送迎の介助をすることもあります。<br>車いすの場合は乗り降りも簡単ではありませんので、私たちが安全にサポートします。<br>車いすや体の向き、動かす順番などに注意しながら移動します。
		.sec04
			.secWrap
				.pageSecTitle.fadeUp
					p OFFICE
					.secTitle
						h2 事務所
				.secBox.fadeUp
					.photo
						img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/working_sec04_img.png", alt="")
					.txtBox
						h3 訪問介護サービスまはろ
						.infoBox
							.dl
								.dt
									p 住所
								.dd
									p 〒 630-8113　奈良県奈良市法蓮町543-1
							.dl
								.dt
									p TEL
								.dd
									a(href="tel:0742936924")
										div
											p 0742-93-6924
							.dl
								.dt
									p FAX
								.dd.fax
									a(href="#")
										div
											p 0742-93-6925
							.dl
								.dt
									p 営業時間
								.dd
									p 平日10：00~17：00
							.dl
								.dt
									p 対応エリア
								.dd
									p 奈良市、大和郡山市、天理市、橿原市、木津川市、<br>京都南エリアなど
				.listContainer
					.ttl.fadeUp
						p 私たちと一緒に働きませんか？
					.btnMoreBox.fadeUp
						.btnMore
							a(href="recruit?sec05")
								div
									p 応募フォームはこちら
					.listBox
						.ul
							.li.fadeUp
								img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/working_sec04_list_01.png", alt="")
							.li.fadeUp
								img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/working_sec04_list_02.png", alt="")
							.li.fadeUp
								img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/working_sec04_list_03.png", alt="")
