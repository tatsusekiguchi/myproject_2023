// ▽メイン▽
.aboutMain.main
	.pageKvContainer
		.pageKvPanel
			.pageKvTitle
				p ABOUT US
				h1 私たちについて
	.mainContainer
		.sec01
			.secWrap.fadeUp
				.pageSecTitle
					p CONCEPT
					.secTitle
						h2 自分らしく豊かな人生を送れる社会のために。
				.txt
					p できるだけ住み慣れた自宅で生活を続けたい。<br>そんな方のための訪問介護から私たちは事業を始めました。<br>自分らしく暮らすお手伝いをする中で、<br>より多くの人の人生を豊かにしていきたい、<br>という思いが大きくなり、マリン事業を始めることを決めました。<br>私たちの活動がひとりの人生を少しでも豊かにできたら、<br>そんなに嬉しいことはありません。
		.sec02
			.secWrap
				.secContainer.fadeUp
					.pageSecTitle
						p OUR PROMISE
						.secTitle
							h2 私たちの約束
					.listBox
						.ol
							.li.fadeUp
								.num
									p 01
								.photo
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec02_img_01.png", alt="")
								.dl
									.dt
										p ひとりに向き合います
									.dd
										p 私たちはご利用者さまやお客さまひとりひとりと向き合います。員に対して同じ対応をするのではなく、目の前のお客さまやご利用者さまのことを第一に考えます。
							.li.fadeUp
								.num
									p 02
								.photo
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec02_img_02.png", alt="")
								.dl
									.dt
										p 人財を育成します
									.dd
										p 長時間労働や人手不足の問題に取り組み、スタッフが働きやすい環境を整えることで、人財を育成します。<br>人財の育成を通じて、社会に貢献してまいります。
							.li.fadeUp
								.num
									p 03
								.photo
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec02_img_03.png", alt="")
								.dl
									.dt
										p 挑戦を続けます
									.dd
										p 多くの人がより豊かな人生を送れるよう、新たな事業を展開していきます。<br>これからも、目的を達成するために挑戦を続けていきます。
		.sec03
			.secWrap
				.secContainer.fadeUp
					.txtBox
						.pageSecTitle
							p STRATEGY
							.secTitle
								h2 介護サービスを軸として<br>マリンアクティビティやグランピングなど<br>幅広い事業を展開
						.txt
							p LiLuLeA株式会社 では、自分らしい豊かな人生が送れるよう、介護サービスを軸にマリンアクティビティやグランピングなど幅広い事業を展開しています。<br>若い世代から高齢者まで、多くのお客さまの人生に寄り添うサービスを提供していきます。
					.iconBox
						.iconList
							.ul
								.li
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec03_list_01.png", alt="")
								.li
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec03_list_02.png", alt="")
								.li
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec03_list_03.png", alt="")
								.li
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec03_list_04.png", alt="")
								.li
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec03_list_05.png", alt="")
								.li
									img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec03_list_06.png", alt="")
		.sec04
			.secWrap
				.pageSecTitle.fadeUp
					p SERVICE
					.secTitle
						h2 事業一覧
				.secContainer
					.secPanel.fadeUp
						.photo
							img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec04_img_01.png", alt="alt")
						.txtBox
							.inner
								.ttl
									h3 介護事業
								.txt
									p 高齢者が安心して自分らしい生活が送れるよう、日常的なサポートや身体介護、重度訪問介護などの訪問介護を行っています。<br>また、より多くの人のご要望にお応えするため、介護タクシーや民間救急を始めました。
								.btnMoreBox
									.btnMore
										a(href="nursing")
											div
												p READ MORE
					.secPanel.fadeUp
						.photo
							img(src="https://lilulea230823.smooooth.jp/system_panel/uploads/images/about_sec04_img_02.png", alt="alt")
						.txtBox
							.inner
								.ttl
									h3 マリン事業
								.txt
									p 慌ただしい日常から離れ、海の近くでリラックスしていただけるグランピングや、存分に海を楽しめるマリンアクティビティなどのサービスを提供しています。<br>また、海の近くの楽園のような介護施設のオープンを予定しています。
								.btnMoreBox
									.btnMore
										a(href="marine")
											div
												p READ MORE
// △メイン△