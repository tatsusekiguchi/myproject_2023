				.topTxt
					.txt
						p 下記フォームよりご応募いただけます。<br>必要事項をご入力いただき、プライバシーポリシーに同意の上送信ください。<br>3営業日以内に担当より折り返しご連絡いたします。
				.contactForm
					form(data-formtype="1" method="post" action="contactComplete" name="form").form
						.formBox
							.dl
								.dt
									p.span お名前
									p.em 必須
								.dd
									input(type="text" class="name" name="お名前" placeholder="例)山田　太郎" data-displaynameattr="お名前").validateRequired
							.dl
								.dt
									p.span フリガナ
									p.em 必須
								.dd
									input(type="text" class="kana" name="フリガナ" placeholder="例)ヤマダ　タロウ" data-displaynameattr="フリガナ").validateKatakana1
							.dl
								.dt
									p.span 生年月日
									p.em 必須
								.dd
									input(type="text" name="生年月日" placeholder="例）2015/4/1" data-displaynameattr="生年月日").validateRequired
							.dl
								.dt
									p.span 郵便番号
									p.em 必須
								.dd
									.postalBox
										p.postalTxt 〒
										input(type="text" class="postal_01 zip1" name="postal_01" placeholder="123" data-displaynameattr="郵便番号上3桁" ).validateRequired
										p.span -
										input(type="text" class="postal_02 zip2" name="postal_02" placeholder="4567" data-displaynameattr="郵便番号下4桁" ).validateRequired
							.dl
