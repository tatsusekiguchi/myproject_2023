// ▽header▽
header.header
    .headBox
        .logo
            a(href=(root_path || ''))
                img(src=(root_path || '') + "image/common/header_logo.png", alt="Lagom")
        nav.navBox
            .navBox__list
                ul
                    li
                        a(href="#concept") Lagomコンセプト
                    li
                        a(href="") イベント情報　
                    li
                        a(href="") Lagomポイント
                    li
                        a(href="") 家が建つまで
                    li
                        a(href="") よくある質問
                .navBox__list__insta
                    a(href="https://www.instagram.com/lagom_marukyo/", target="_blank", rel="noopener")
                        img(src=(root_path || '') + "image/common/header_insta.png", alt="")
            .navBox__item
                ul
                    li.contactLink
                        a(href="#contact") お問い合わせ
                    li.hamburgerBox
                        .hamburger
                            span
                            span
                            span
    .subNavigationContainer
        .subNavigation
            .subNavigation__wrap
                .subNavigation__main
                    .subNavigation__main__wrap
                        .subNavigation__main__logo
                            img(src=(root_path || '') + "image/common/navigation_logo.png", alt="Lagom")
                        .subNavigation__main__list
                            ul
                                li
                                    a(href="#concept")
                                        em concept
                                        span ラーゴムのコンセプト
                                li
                                    a(href="")
                                        em NEWS&amp;EVENT
                                        span ニュース＆イベント
                                li
                                    a(href="")
                                        em Lagom’s Point
                                        span ラーゴムのポイント
                                li
                                    a(href="")
                                        em FAQ
                                        span よくある質問
                            ul
                                li
                                    a(href="")
                                        em Flow
                                        span 家が建つまで
                                li
                                    a(href="")
                                        em Contact
                                        span お問い合わせ
                                li
                                    a(href="")
                                        em Company
                                        span 会社概要
                .subNavigation__bottom--pc
                    .bnr__entry
                        .photoBox
                            .photo
                                img(src=(root_path || '') + "image/common/navigation_bnr_img.png" alt="")
                        .txtBox
                            .inner
                                .logo
                                    img(src=(root_path || '') + "image/top/top_bnr_entry_logo.png", alt="")
                                .ttl
                                    p イベント・内覧会の予約はこちら
                                    .ttl__img
                                        img(src=(root_path || '') + "image/common/navigation_bnr_title.png" alt="イベント・内覧会の予約はこちら")
                                .btn
                                    a(href="") CLICK
                    .contactBox
                        .ttl
                            p お問い合わせ
                        .txtBox
                            dl.sns
                                dt FOLLOW ME
                                dd
                                    ul
                                        li.insta
                                            a(href="https://www.instagram.com/lagom_marukyo/", target="_blank", rel="noopener")
                                                img(src=(root_path || '') + "image/common/navigation_insta.png", alt="")
                                        li.tweet
                                            a(href="", target="_blank", rel="noopener")
                                                img(src=(root_path || '') + "image/common/navigation_tweet.png", alt="")
                                        li.youtube
                                            a(href="", target="_blank", rel="noopener")
                                                img(src=(root_path || '') + "image/common/navigation_youtube.png", alt="")
                            .copy
                                p COPYRIGHT （C） Lagom ALL RIGHTS RESERVED.
                .subNavigation__bottom--sp
                    dl.sns
                        dt FOLLOW ME
                        dd
                            ul
                                li.insta
                                    a(href="https://www.instagram.com/lagom_marukyo/", target="_blank", rel="noopener")
                                        img(src=(root_path || '') + "image/common/footer_insta.png", alt="")
                                li.tweet
