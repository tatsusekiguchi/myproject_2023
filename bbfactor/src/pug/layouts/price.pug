main#price
	.pageKvPanel
		.pageKvTitle
			h1 料金・車種
	.sec01
		.secWrap01
			.pageSecTitle
				.icon
					img(src=(root_path || '') + "image/common/page_sec_title_icon.png", alt="")
				.secTitle
					h2 料金
			.subTitle
				h3 ビーブリッジファクターの料金はシンプルに一律料金です。
			.priceContainer
				.priceBox01
					dl
						dt
							em 当日返却
							span ※当日の受付時間内でのご返却
						dd
							em 00000
							span 円（税別）
					dl
						dt
							em 1泊2日
							span ※受付当日から翌日の１８時までのご利用。
						dd
							em 00000
							span 円（税別）
				.priceBox02
					dl
						dt 以降1時間毎
						dd
							em 00000
							span 円（税別）
					dl
						dt 以降1日毎
						dd
							em 00000
							span 円（税別）
	.sec02
		.secWrap01
			.pageSecTitle
				.icon
					img(src=(root_path || '') + "image/common/page_sec_title_icon.png", alt="")
				.secTitle
					h2 車種紹介
			.introContainer
				#intro01.introPanel
					.secBox
