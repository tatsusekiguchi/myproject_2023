		.slideBox
			ul
				li
					img(src=(root_path || '') + "image/info/info_slide_01.png", alt="")
				li
					img(src=(root_path || '') + "image/info/info_slide_02.png", alt="")
				li
					img(src=(root_path || '') + "image/info/info_slide_03.png", alt="")
				li
					img(src=(root_path || '') + "image/info/info_slide_04.png", alt="")
				li
					img(src=(root_path || '') + "image/info/info_slide_05.png", alt="")
	.sec02
		.secWrap02.fadein
			.secTtl
				h2
					img(src=(root_path || '') + "image/info/title_access.png", alt="アクセス")
			.txt
				p 名古屋駅からこんふれ　あえるまでのわかりやすいなびげーとをいたします。
