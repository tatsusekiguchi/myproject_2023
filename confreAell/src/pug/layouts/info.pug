		.pageKvPanel
			.kvTitle
				h1
					img(src=(root_path || '') + "image/info/kv_title.png", alt="店舗紹介")
	.sec01
		.secWrap02.fadein
			.infoBox
				dl
					dt 店舗名
					dd confre Aell（こんふれ　あえる）
				dl
					dt 住所
					dd 愛知県名古屋市中村区名駅4丁目25-16　ウインズ名駅5F
