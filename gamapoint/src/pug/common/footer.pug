footer.footer
	.pagetop
		a(href="#")
			img(src=(root_path || '') + "image/common/pagetop.png", alt="")
	.topLogo
		.logo
			img(src=(root_path || '') + "image/common/footer_logo.png", alt="")
	.appTitle
		p 蒲郡市民のための<br class="spBreak">ポイ活アプリ
	.contactPanel
		.gamapointTitle
			img(src=(root_path || '') + "image/common/footer_gamapoint.png", alt="")
		.contactTitle
			p がまポイントに関するお問い合わせはこちらから
		dl
			dt アスリブコールセンター
			dd
				a(href="tel:0647966011")
					span tel.
					em 06-4796-6011
				.txt
					p 【受付時間】午前10時～午後5時（土日・祝日・年末年始を除く）
		.infoPanel
			dl
				dt アスリブコールセンターは2023年10月2日<br>12:00からご利用いただけます。
				dd
					.txt
						p アスリブコールセンターへのお問い合わせは2023年10月2日12時からご利用いただけます。それ以前にご連絡いただいてもご利用いただくことができません。予めご了承ください。
	.btnOhp
		a(href="https://www.city.gamagori.lg.jp", target="_blank", rel="noopener")
			img(src=(root_path || '') + "image/common/footer_btn_ohp.png", alt="")
	.copy
		p &copy;2023 蒲郡市.
