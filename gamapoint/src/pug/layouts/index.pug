// ▽メイン▽
main#topMain
	.topKvContainer
		.topKvPanel
			.topKvBox
				.kvTitle
					h1
						img(src=(root_path || '') + "image/top/top_kv_title_pc.png", class="switch" alt="蒲郡市民のためのポイ活アプリがまポイント")
				.appBnrBox
					p アプリインストールはこちら
					.bnrList
						.bnr
							a(href="", target="_blank", rel="noopener")
								img(src=(root_path || '') + "image/top/bnr_appstore.png", alt="")
						.bnr
							a(href="", target="_blank", rel="noopener")
								img(src=(root_path || '') + "image/top/bnr_googleplay.png", alt="")
				.kvInfoPanel
					dl
						dt アスリブアプリ内のがまポイント対応は<br>2023年10月2日 12:00を予定しております。
						dd
							.txt
								p アプリダウンロードは2023年10月2日 12:00以降にダウンロードをお願いいたします。事前にダウンロードを行うと、がまポイント対応の為に一度退会していただき、再度アカウント（別のメールアドレス）を作成していただく必要がございます。
	#about.section__about.section.fadeUp
		.secWrap01
			.secTitleBox
				h2 がまポイントとは
				p ABOUT
			.introBox
				.txt
					p 「がまポイント」とは、蒲郡市民のためのポイ活アプリです。<br>ウォーキングや毎日の健康記録、ポイント対象のイベントに参加やコラムを読んだりアンケートに応えたりなど<br class="pcBreak">でポイントが貯まり、電子マネー等に交換できるうれしい機能付き。<br>楽しくポイ活ができます！<br>※ポイント付与と特典の交換には期限があります。<br>詳細は蒲郡市ホームページなどをご確認ください。
				.logo
					img(src=(root_path || '') + "image/common/header_logo.png", alt="蒲郡市xアスリゴ")
			.limitedContainer
				.limitedPanel
					.ttlBox
						dl
							dt 期間限定
							dd
								p アプリダウンロード＆<br class="spBreak">マイナンバーカードの認証完了で
					.appleWatch
						img(src=(root_path || '') + "image/top/top_apple_watch.png", alt="")
					.presentTtl
						p
							| 抽選で
							em 5
							| 名様にプレゼント！
					.presentTxt
						.txt
							p
								em ※マイナンバーカード認証時に18歳になっていること
								| が条件です。
							p ※2023年10月～ 2023年12月にマイナンバーマイナンバーカードによる本人認証を完了した方が対象です。
					.term
						.txt
							p キャンペーン期間：<br>2023年10月2日（月）～ 2023年12月31日（日）まで
	#merit.section__merit.section.fadeUp
		.secWrap01
			.secTitleBox
				h2 がまポイントのメリット
				p MERIT
			.meritListBox
				ol
					li
						.numBox
							p.ttl メリット
							p.num 1
						dl
							dt 電子マネーやギフト<br class="pcBreak">券等と交換できる！
							dd
								.imgBox
									.img01.img
										img(src=(root_path || '') + "image/top/merit_img_01.png", alt="")
								.txt
									p 貯まったポイントは500ポイント～の電子マネーやAmazonギフト券等と交換できる
					li
						.numBox
							p.ttl メリット
							p.num 2
						dl
							dt 貯まったポイントで<br class="pcBreak">抽選に参加できる！
							dd
								.imgBox
									.img02.img
										img(src=(root_path || '') + "image/top/merit_img_02.png", alt="")
								.txt
									p あなたが貯めたポイントで抽選に参加できます。<br>ポイントを貯めて毎週・毎月の抽選に参加しよう！
					li
						.numBox
							p.ttl メリット
							p.num 3
						dl
