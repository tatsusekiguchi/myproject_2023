// ▽メイン▽
.productMain.main
	.pageKvPanel
		.pageKvBox
			.pageKvTitle
				h1 黒柳製粉の商品
	.sec01
		.secWrap
			.pageSecTtlBox.fadeUp
				.pageSecTtl
					h2 取り扱い商品
				.sub
					p products
			.topSection
				.secTtl.fadeUp
					h3 ライスフラワーミズホチカラ
				.message.fadeUp
					p 失敗しない米粉パン専用米粉！<br>自宅でお手軽もちもち米粉パン♪
				.secPanel
					.photo
						img(src="https://kuroyanagiseifun231003.smooooth.jp/system_panel/uploads/images/product_sec01_top_img.png", alt="")
					.txtBox.fadeUp
						.txt
							p 米粉でつくるパンは難しい。<br>黒柳製粉ではそんな皆様のお声にお応えし、ご自宅でもお手軽にもちもちの米粉パンをお楽しみいただけるようパン専用の米粉を作りました。
							p 新商品ライスフラワーミズホチカラは、パン専用に選び抜いた品種「ミズホチカラ」を使用し、弊社独自の製粉法でパンを焼くのに最適な米粉に仕上げております。
							p ミズホチカラで焼きあがったパンは、いままでの米粉よりもふっくらで、しっとり、もちもちの食感をお楽しみいただけます。<br>そしてなにより「失敗しない」パン作りをお約束いたします。
				.itemList
					.itemBox
						.inner
							.unit
								p 500ｇ
							.photo
								img(src="https://kuroyanagiseifun231003.smooooth.jp/system_panel/uploads/images/product_sec01_item_01.png", alt="")
							.dl
								.dt
									p ライスフラワー<br>ミズホチカラ
								.dd
									p 商品名が入ります
					.itemBox
						.inner
							.unit
								p 500ｇ
							.photo
								img(src="https://kuroyanagiseifun231003.smooooth.jp/system_panel/uploads/images/product_sec01_item_02.png", alt="")
							.dl
								.dt
									p ライスフラワー<br>ミズホチカラ<br>20kg（クラフト入り）
								.dd
									p 商品名が入ります
				.txt
					p 豊田生協メグリア各店舗にてお買い求めいただけます。
		.listContainer
			.secWrap01
				.listBox
					.ul
						.li.fadeUp
							.photo
								img(src="https://kuroyanagiseifun231003.smooooth.jp/system_panel/uploads/images/product_sec01_list_01.png", alt="")
							.dl
								.dt
									h3 失敗しない米粉
								.dd
									p 作り方は材料を入れて混ぜるだけ。<br>膨らまなくて失敗してしまったという経験をお持ちの方でも自信を持ってパン作りができるパン作りに「失敗しない」米粉です。
						.li.fadeUp
							.photo
								img(src="https://kuroyanagiseifun231003.smooooth.jp/system_panel/uploads/images/product_sec01_list_02.png", alt="")
							.dl
								.dt
									h3 米粉パン専用米粉
								.dd
									p ミズホチカラは米粉パン専用に開発された「ミズホチカラ」を使用しております。<br>米粉パン専用の米粉だから焼き上がりは想像以上のふっくら感ときめ細やかさを実感いただけます。
						.li.fadeUp
							.photo
								img(src="https://kuroyanagiseifun231003.smooooth.jp/system_panel/uploads/images/product_sec01_list_03.png", alt="")
							.dl
								.dt
									h3 安心のグルテンフリー
								.dd
									p ミズホのチカラには、アレルギー症状を起こすグルテン（小麦などの穀物に含まれるたんぱく質の一種）が含まれておらず、アレルギーの方にも安心してご利用いただけます。
	.sec02
		.secWrap01
			.secTtl.fadeUp
				h2 失敗しない<br>米粉レシピ公開中！
			.photoList.fadeUp
				.ul
					.li
						a(href="" data-lightbox="lightBox")
							.photoBox
								.photo
									img(src="https://kuroyanagiseifun231003.smooooth.jp/system_panel/uploads/images/product_sec02_img_01.png", alt="")
								p 米粉パン　ホームベーカリー使用（1斤）
					.li
						a(href="" data-lightbox="lightBox")
							.photoBox
								.photo
									img(src="https://kuroyanagiseifun231003.smooooth.jp/system_panel/uploads/images/product_sec02_img_02.png", alt="")
								p 米粉パン　オーブン使用（9×18×高さ9cm食パン型1本分）
			.secPanelList.fadeUp
				.secPanel
					.panelTitle
						h3 米粉パン ホームベーカリー使用（1斤）
					.infoBox
						.dl
							.dt
								p 材料
							.dd
								p パン用米粉ミズホチカラ280g /  砂糖25g / 食塩4g / キャノーラ油10g / インスタントドライイースト3g / 水230g
						.ul
							.li
								.dl
									.dt
										p STEP.01
									.dd
										p キャノーラ油、水以外の材料を予め混ぜておく。
							.li
								.dl
									.dt
										p STEP.02
									.dd
										p 全ての材料をホームベーカリー容器に入れ、「葉や焼きモード」を選択しスタートを押す。
					.aside
						p □ドライイーストの投入口がある機種では、投入口に入れてください。<br>□ご使用の機器、室温などの条件によって、パンのふくらみや形に差が出ます。<br>□パンの上部に気泡が出たり、焼き色が付きにくいことがありますが、品質には問題ございません。
				.secPanel
					.panelTitle
						h3 米粉パン　オーブン使用（9×18×高さ9cm食パン型1本分）
					.infoBox
						.dl
							.dt
								p 材料
							.dd
								p パン用米粉ミズホチカラ280g /  砂糖25g / 食塩4g / キャノーラ油10g / インスタントドライイースト3g / 水230g
						.ul
							.li
								.dl
									.dt
										p STEP.01
									.dd
										p ボウルにぬるま湯（夏場25℃、冬場30℃）を入れドライイーストを予め溶かしておく。
							.li
								.dl
									.dt
										p STEP.02
									.dd
										p 全ての材料を①に入れ、よく混ぜ合わせる。
							.li
								.dl
									.dt
										p STEP.03
									.dd
										p ラップで蓋をしｍ室温に20分置く。
							.li
								.dl
									.dt
										p STEP.04
									.dd
										p もう一度混ぜ合わせｍ油をひいた型に流し込む。
							.li
								.dl
									.dt
										p STEP.05
									.dd
										p 38℃の暖かいところに40分置く。※1
							.li
								.dl
									.dt
										p STEP.06
									.dd
										p 210℃に予熱したオーブンで40分焼く。
					.aside
						p □※1　約2倍に膨らみます。ふくらみが足りない場合は発酵時間を延ばしてください。
// △メイン△