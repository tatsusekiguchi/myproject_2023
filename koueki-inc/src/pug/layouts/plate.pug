                                p ガラス工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_06.png", alt="")
                    .li
                        a(href="roof")
                            div
                                p 屋根/タイル・レンガ<br>・ブロック工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_07.png", alt="")
                    .li
                        a(href="fittings")
                            div
                                p 建具工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_08.png", alt="")
