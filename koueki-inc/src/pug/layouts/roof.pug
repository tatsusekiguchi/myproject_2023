                                p 解体工事/<br>アスベスト事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_02.png", alt="")
                    .li
                        a(href="interior")
                            div
                                p 内装工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_03.png", alt="")
                    .li
                        a(href="painting")
                            div
                                p 塗装/防水工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_04.png", alt="")
                    .li
                        a(href="plasterer")
                            div
                                p 左官/石工工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_05.png", alt="")
                    .li
                        a(href="glass")
                            div
                                p ガラス工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_06.png", alt="")
                    //- .li
                    //-     a(href="roof")
                    //-         div
                    //-             p 屋根/タイル・レンガ<br>・ブロック工事業
                    //-             img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_07.png", alt="")
                    .li
                        a(href="fittings")
                            div
                                p 建具工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_08.png", alt="")
                    .li
                        a(href="plate")
                            div
                                p 板金工事業
                                img(src="https://koeki221206.smooooth.jp/system_panel/uploads/images/business_page_link_bg_09.png", alt="")
