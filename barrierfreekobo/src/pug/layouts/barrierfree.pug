// ▽メイン▽
.barrierfreeMain.main.formMain
    .pageKvContainer
        .pageKvPanel
            .pageKv
                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_kv.png", alt="")
            .kvTitle
                h1 バリアフリーの目的
    .sec01
        .secWrap01
            .secTtl.fadeUp
                h2 生活する中でこのような問題ありませんか？<br>あなたの家のバリアフリーチェック
            .listBox.fadeUp
                .ul.listAnim
                    .li
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec01_img_01.png", alt="")
                        .dl
                            .dt
                                p 段差でよくつまづく
                    .li
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec01_img_02.png", alt="")
                        .dl
                            .dt
                                p 階段を昇るのが大変
                    .li
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec01_img_03.png", alt="")
                        .dl
                            .dt
                                p 手すりを欲している
            .arrow.fadeUp
                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec01_arrow.png", alt="")
            .messagePanel.fadeUp
                .messageBox
                    .messageInner
                        .message
                            p このようなお悩みに当てはまる方は
                        .message
                            p.em バリアフリーリフォーム
                            p でお悩みを解決することができます！
    .sec02
        .secWrap01
            .pageSecTtl.fadeUp
                p Pick up Reform
                h2 リフォーム
            .secContainerList
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_01.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 約1週間
                    .txtPanel
                        .panelTtl
                            h3 毎日欠かさないトイレ
                        .txt
                            p 誰もが毎日使用するトイレ、いろんな不満がありながらもそのままにしていませんか？<br>障がいの有無を問わず、誰もがいつでも快適で衛生的なトイレを使えるように、トイレの視点、利用者の視点から、ご予算に合わせた最適なトイレリフォームをご提案いたします。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p リビングからトイレまでの動線を相談したい。<br>また、腰の調子が悪く立ち座りがきつくなってきたので何とかしたい。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p 歩行器を使用して生活しているお客様がいる場合は動線の単純化を行います。<br>電気を付ける動作を無くす、自動トイレにするなど、単純化しうより生活を楽にいたします。<br>また、動作を減らすことにより転ぶリスクを減らす事ができます。
                        .aside
                            p トイレのスペースを広くする工事も承っておりますが、<br>マンションにお住まいの方は出来ない場合がございます。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_02.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 3日
                    .txtPanel
                        .panelTtl
                            h3 お家への入口、玄関
                        .txt
                            p 玄関リフォームで家の印象を変えたい時、まずご検討いただきたいのが、庭や道路までのアプローチや段差の高さです。<br>道路に出る道が凸凹していてつまづく、玄関から室内に入る段差が高いなど。<br>荒い砂利やコンクリートのアプローチの場合、転んだ時に大怪我に繋がる恐れがございます。<br>そんな室外移動時の事故を未然に防ぐことで
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p 古く防犯面や段差による怪我が心配。<br>風が入らず、暗い雰囲気をなんとかしたい。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p ドアに網戸を付けられるものにすると気持ち良い風も入ります。<br>庭や駐車場までのアプローチも植栽を植える事で華やかに。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_03.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 約1ケ月
                    .txtPanel
                        .panelTtl
                            h3 デザイン性、機能性のある室内扉
                        .txt
                            p お子さまの成長や、ご両親のためのバリアフリー化に合わせて、家の中のドアを取り換えようと考えている方も多いのではないでしょうか。<br>家族みんなが暮らしやすい住まいづくりを目指すためには、家族や住まいの状況に合った室内ドアを選択する必要があります。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p 子供部屋を寝室にリフォームするにあたり、お部屋に合ったドアへ変更したい。<br>将来介護が必要になってもいいように、引き戸に変更したい。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p 寝室へのドアは落ち着いた木目調のドアがオススメです。<br>ご相談いただいたお客様のお家は引き戸にリフォームすることができる間取りでしたので開き戸から引き戸へ変更、閉めた音も静かな室内扉をご提案。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_04.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 約1ケ月
                    .txtPanel
                        .panelTtl
                            h3 お出かけ、通院に困らないスロープ
                        .txt
                            p ご家族の高齢化と共にますます真剣に考えるご自宅のバリアフリー化。<br>特に玄関を出た際の段差にお悩みを持っている方は多いです。<br>足腰が弱くなってくる前にスロープを付けておきたい、車いすでも通れるようにしたいなど、様々なスロープに関するリフォームがございます。<br>また、レンガ、コンクリートなど材質により印象、安心感も変わってきます。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p 祖父の通院、家族で買い物に行く際の段差の昇り降りを負担に感じる。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p 段差の高い階段を緩やかな長いスロープへ。<br>車いすなどでも室内に出入りできるように高低差の低いスロープご提案。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_05.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 約1ケ月
                    .txtPanel
                        .panelTtl
                            h3 年齢を重ねると辛くなる、上下階の移動
                        .txt
                            p 若い頃は不満に思わなかった上下階の移動。<br>年齢を重ねていくにつれて、足腰が悪くなり、一階から二階への移動が辛くなってきます。<br>また、障がいによる麻痺がある方などは階段昇降機などの設置提案も可能です。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p 子供の介護が必要になり上下階の移動を楽にしてあげたい。<br>キッチンなどの設備を二階に上げるなどの大規模な工事は避けたい。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p 間取りを変えたくない、大きな工事もしたくない、というお客様には階段や壁に補強などの工事が不要な階段昇降機の設置をご提案。<br>コンパクトに折りたたむ事ができる為、階段をそのまま昇る方にも影響なくお過ごしいただけます。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_06.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 約1ケ月
                    .txtPanel
                        .panelTtl
                            h3 毎朝使用する洗面台
                        .txt
                            p 顔や手を洗う、身支度を整えるなど一日に何回も使用する洗面台。<br>収納する箇所が少ない、車いすでは手が届かなく遠いなどというお悩みはございませんか？<br>気持ちよく生活する為に洗面台のリフォームを検討してみましょう。<br>洗面台では鏡のタイプ、掃除のしやすさ、色やデザインが沢山あるため、お家の雰囲気に合わせて選ぶことができます。<br>また、車いすの方ように洗面の下の収納を無くした洗面台なども工事可能です。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p 蛇口が伸びず屈む体制がきつい、三面鏡の洗面台にしたい。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p 段差の高い階段を緩やかな長いスロープへ。<br>車いすなどでも室内に出入りできるように高低差の低いスロープご提案。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_07.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 約1ケ月
                    .txtPanel
                        .panelTtl
                            h3 身体をリフレッシュさせるお風呂
                        .txt
                            p タイル貼りの浴槽は寒い、目地の掃除が大変というお声をよくいただきます。<br>毎日入る浴槽だけに身体に不可のかからないユニットバスにしたいという方はご相談ください。<br>特にご高齢の方がいるご家族の方は床材も冷たく感じない材質を使用することでヒートショック予防にも繋がります。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p タイル貼りの浴槽で断熱性がなく、気温が低い冬は寒い。<br>また、祖父祖母も入る浴槽の為高くない浴槽を取り入れたい。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p お客様のご要望に加え、浴槽内の転倒事故を防ぐ滑りにくい床を使用。<br>また、浴槽を床より一段低い場所に設置することで従来型に比べ、<br>またぎやすく、安全な作りに。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_08.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 1週間以内
                    .txtPanel
                        .panelTtl
                            h3 冬でも温かい床暖房
                        .txt
                            p 冬になると冷たい床から身体が冷えて寒いというお悩みございませんか？<br>家族みんなが使うリビングやお風呂などにも導入できる床暖房。<br>生活動線によってダイニング部分とリビング部分のみにつけるなどといった細かなご注文も承っております。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p 家を建てたときには費用をできるだけ抑えたかった為に床暖房は付けませんでした。<br>しかし、暮らしていく内に床暖房をいれたいなという思いになりました。<br>小さな子供が床にいても温かく安心できる床暖房を付けたいです。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p 小さなお子様が床に寝ていても安心な温水式床暖房のご提案。<br>電気式より低温の為、低温やけどを起こす危険もありません。<br>設置時の初期費用は電気式よりコストがかかりますが、長期的に見ると電気式より安く費用を抑えることが出来ます。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_09.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 約1ケ月
                    .txtPanel
                        .panelTtl
                            h3 転倒の危険がある段差
                        .txt
                            p 室内、室外の段差、高さの高いものから数センチの段差まで。<br>その数センチでも大怪我に繋がる恐れがある事、ご存じですか？<br>スリッパを履いていて段差に気づかなかった、扉にある数センチの段差に足が突っかかったなど。<br>段差対策できる内容からリフォームなどでしか直せない内容まで、まずはお気軽にご相談ください。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p 三段の階段があったお家、今まで壁を頼りにしていましたが手すりを設置したいというご相談。駐車場までの段差をアーチ状の手すりで安全に移動できるように。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p 三段の階段があったお家、今まで壁を頼りにしていましたが手すりを設置したいというご相談。駐車場までの段差をアーチ状の手すりで安全に移動できるように。
                .secContainer.fadeUp
                    .photoPanel
                        .photoBox
                            .photo
                                img(src="https://barrierfreekobo231120.smooooth.jp/system_panel/uploads/images/barrierfree_sec02_img_10.png", alt="")
                        .infoBox
                            .dl
                                .dt
                                    p 形態
                                .dd
                                    p 一戸建て
                            .dl
                                .dt
                                    p 工事期間
                                .dd
                                    p 1日～3日
                    .txtPanel
                        .panelTtl
                            h3 安全に暮らす為の手すり
                        .txt
                            p 後付けできる手すりのリフォームは将来の為に設置や、ご高齢のご家族の為になど設置理由はさまざまです。<br>また、設置場所も様々で室外どちらも工事することが可能です。<br>浴槽を出るため、トイレの便座から上がるため、夜遅い廊下を歩く為など。<br>ご要望によりライトの付く手すりや最適な高さのご提案をさせていただきます。
                        .introBox
                            .dl
                                .dt
                                    p ご相談内容
                                .dd
                                    p 玄関までのアプローチに砂利があり、転ぶ可能性があって危ない。<br>足腰が弱い家族もいるので体重をかけられる手すりがほしい。
                            .dl
                                .dt
                                    p 合同会社バリアフリー工房の提案
                                .dd
                                    p 雨が降っても頑丈で錆びにくいステンレス製の手すりがおすすめです。<br>しかし、熱を伝えやすい素材の為、樹脂をコーティングした手すりのご提案。<br>また、L字型の手すりにより立ち上がりの補助と移動、起き上がりのサポートが可能。
            .btnList.fadeUp
                .btnBox
                    .btnMore.pagerLink
                        a(href="service?sec03")
                            div
                                p お問い合わせ
                .btnBox
                    .btnMore
                        a(href="caselist")
                            div
                                p 他の事例を見る
    .sec03
        .secWrap01
            .pageSecTtl.fadeUp
                p Flow
                h2 ご相談、施工の流れ
            .flowList
                .ol
                    .li.fadeUp
                        .dl
                            .dt
                                p.em STEP.01
                                p.span お問い合わせ
                            .dd
                                .txt
                                    p まずは、フォームまたはお電話にてお問い合わせ・ご相談ください。
                    .li.fadeUp
                        .dl
                            .dt
                                p.em STEP.02
                                p.span 事前打合せ<br>現地調査
                            .dd
                                .txt
                                    p 現在の不満、叶えたいご要望やご予算、生活スタイルなどをお聞かせください。
                                .txt
                                    p.span また、お住まいの現場確認にお伺いいたします。
                                    p.em ※生活動線や高齢者様の身体の確認も行います。
                    .li.fadeUp
                        .dl
                            .dt
                                p.em STEP.03
                                p.span プラン提案
                            .dd
                                .txt
                                    p ご要望を反映させたプランとお見積もりをご提案いたします。
                    .li.fadeUp
                        .dl
                            .dt
                                p.em STEP.04
                                p.span ご契約
                            .dd
                                .txt
                                    p プランの内容にご納得いただけましたらご契約となります。
                                .txt
                                    p.em ※ご希望に合わないプランなど、無理なご契約は行いませんのでご安心ください。
                    .li.fadeUp
                        .dl
                            .dt
                                p.em STEP.05
                                p.span 工事着工
                            .dd
                                .txt
                                    p 必要な手続きを行い工事を開始いたします。
                    .li.fadeUp
                        .dl
                            .dt
                                p.em STEP.06
                                p.span お支払い
                            .dd
                                .txt
                                    p 工事完了後、ご確認いただきご請求、お支払いとなります。
                    .li.fadeUp
                        .dl
                            .dt
                                p.em STEP.07
                                p.span アフターフォロー
                            .dd
                                .txt
                                    p 工事完了の確認後、工事保証書類をお渡しいたします。
// △メイン△