// ▽header▽
header.header
    .headBox
        .logo
            a(href=(root_path || ''))
                img(src=(root_path || '') + "image/common/header_logo.png", alt="Lagom")
        .headItem
            .headItem__insta
                a(href="https://www.instagram.com/lagom_marukyo/", target="_blank", rel="noopener")
                    img(src=(root_path || '') + "image/common/header_insta.png", alt="")
            .headItem__scroll
        nav.navBox
            .navBox__list
                ul
                    li
                        a(href="#concept") Concept
                    li
                        a(href="#features") Features
                    li
                        a(href="#openHouse") Open House
                    li
                        a(href="#news") News and Event
                    li
                        a(href="#faq") Faq
                    li
                        a(href="#company") Company
            .navBox__item
                ul
                    li.contactLink
                        a(href="#contact") Contact
                    li.hamburgerBox
                        .hamburger
                            span
                            span
                            span
    .subNavigationContainer
        .subNavigation
            .subNavigation__wrap
                .subNavigation__main
                    .subNavigation__main__wrap
                        .subNavigation__main__logo
                            a(href=(root_path || ''))
                                img(src=(root_path || '') + "image/common/header_logo.png", alt="Lagom")
                        .subNavigation__main__list
                            .subNavigation__main__list__wrap
                                ul.navList
                                    li
                                        a(href="#concept") Concept
                                    li
                                        a(href="") Features
                                    li
                                        a(href="") Open House
                                    li
                                        a(href="") News and Event
                                    li
                                        a(href="") Faq
                                    li
                                        a(href="") Company
                                    li.contact
                                        a(href="") Contact
                                ul.iconList
                                    li.insta
                                        a(href="https://www.instagram.com/lagom_marukyo/", target="_blank", rel="noopener") Instagram
                                    li.line
                                        a(href="#", target="_blank", rel="noopener") LINE
                                    li.tel
                                        a(href="tel:0522287770") 052-228-7770
