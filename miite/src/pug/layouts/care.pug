// ▽メイン▽
.careMain.main.serviceMain
	.pageKvPanel
		.pageKvTitle
			p Hair Care
			h1 ヘアケア
	.sec01
		.secWrap
			.secTitleBox
				p Message
			.secWrapInner
				.secBox
					h2 お客さまの髪のことを一番に考える
					.txt
						p 美容院から帰ったあとも、ずっときれいな髪をキープできるように。<br>miite(ミーテ)ではスペシャルケアやヘッドスパのメニューをご用意しているほか、<br>通常メニューのシャンプーにもこだわっています。<br>また、お家でできるケアやセットの仕方についてのアドバイスもしています。
	.sec02
		.secWrap
			.secTitleBox
				p Hair Care
			.secWrapInner
				.pageSecTitle
					p Feature
					h2 特徴
				.secPanelList
					.secPanel
						.secBox.fadeUp
							.photo
								img(src="https://miite230627.smooooth.jp/system_panel/uploads/images/care_sec02_img_01.png", alt="")
							.txtBox
								.topTitle
									p /01<br>Special Treatment
								.title
									p 髪の状態に合わせて調合する<br>オーダーメイドのトリートメント
								.txt
									p 髪や肌に優しい「バーデンス」を一人ひとりの髪の状態に合わせて調合。<br>髪をサラサラ、つややかにするだけでなく、きっちりコーティングして髪へのダメージを防ぎます。<br>また、グアイアズレンという濃青色の天然由来色素成分が白髪の黄ばみを抑え、<br>目立たなくしてくれるうれしい働きがあります。
						.extraBox.fadeUp
							.inner
								.itemBox
									.photo
										img(src="https://miite230627.smooooth.jp/system_panel/uploads/images/care_sec02_sub_01.png", alt="")
									.txtBox
										.topTitle
											p Puti Gift
										.title
											p オーダーメイドトリートメントをプレゼント
										.txt
											p 自分専用のトリートメントをお持ち帰りいただけます。<br>2～3回分をボトルに入れてお渡ししますので、週1回程度のスペシャルケアにお使いください。
					.secPanel
						.secBox.fadeUp
							.photo
								img(src="https://miite230627.smooooth.jp/system_panel/uploads/images/care_sec02_img_02.png", alt="")
							.txtBox
								.topTitle
									p /02<br>Head Spa
								.title
									p アロマに包まれる癒しのヘッドスパ
								.txt
									p つややかな髪をキープするためにおすすめなのがヘッドスパ。<br>頭皮クレンジングで頭皮の汚れを落としスッキリした後に、<br>アロマトリートメントでヘッドマッサージを受けていただきます。<br>マッサージで血行を高め老廃物を流すことで、頭皮を健やかに保つことができます。<br>頭皮環境を整えながら、アロマに包まれ癒しの時間をお過ごしください。
					.secPanel
						.secBox.fadeUp
							.photo
								img(src="https://miite230627.smooooth.jp/system_panel/uploads/images/care_sec02_img_03.png", alt="")
							.txtBox
								.topTitle
									p /03<br>Hena And Shampoo
								.title
									p 髪と肌に優しいプロダクト
								.txt
									p miiteではシャンプーやカラー剤にもこだわっています。<br>シャンプーは「バーデンス」のシリーズを使用。<br>低刺激で髪や肌に優しく、髪本来の美しさを引き出します。<br>また、自然由来の成分で優しく染められる「ヘナカラー」をご用意。<br>カラー剤を塗布している間に、デトックス効果も期待できます。<br>バーデンスは店頭販売もしています。
								.btnMoreBox
									.btnMore
										a(href="product")
											div
												p 取り扱い商品
					.secPanel
						.secBox.fadeUp
							.photo
								img(src="https://miite230627.smooooth.jp/system_panel/uploads/images/care_sec02_img_04.png", alt="")
							.txtBox
								.topTitle
									p /04<br>Home Care
								.title
									p お家でのケアやセットの仕方を<br>一人ひとりにアドバイス
								.txt
									p シャンプーの刺激が髪にダメージが与えられるって、知っていましたか？<br>正しい家でのヘアケアについては意外と知る機会がありません。<br>miiteでは正しいドライヤーの当て方、シャンプーの仕方など<br>一人ひとりに合わせてアドバイスします。<br>ヘアアイロンやワックスなどを使ったアレンジの仕方もお伝えします。
						.extraBox.fadeUp
							.inner
								.itemBox
									.photo
										img(src="https://miite230627.smooooth.jp/system_panel/uploads/images/care_sec02_sub_02.png", alt="")
									.txtBox
										.topTitle
											p Home Care
										.title
											p 髪がきれいになるドライヤーの当て方
										.txt
											p ドライヤーは髪のキューティクルの流れに沿って、上から下に向けて当てます。<br>キューティクルの流れに沿うことで、指通りがよくつやのある髪に近づきます。<br>横や下から当てると切れ毛や枝毛の原因になるので、気を付けてください。
// △メイン△