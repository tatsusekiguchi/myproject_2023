				.innerSectionContainer
					.imgTbl
						img(src="../image/about_plastic/sec01_tbl_02.png", alt="")
			section.innerSection
				.innerSectionTitle
					h3 発泡プラスチック系断熱材の形状の種類
				.innerSectionContainer
					.photoList
						ul
							li
								img(src="../image/about_plastic/sec01_photo_list_1_1.png", alt="")
								p
									em ボード状断熱材
							li
								img(src="../image/about_plastic/sec01_photo_list_1_2.png", alt="")
								p
									em 部位形状に合わせた断熱材
