// ▽メイン▽
main#featuresMain.pageMain
	.pageKvPanel
		.pageKvTitle
			p Our Features
			h1 私たちの特長
	.topTitlePanel
		.secWrap01
			h2 5つの力＋1で、<br>安心・安全な工事を<br class="spBreak">実現します
	.sectionContainer
		#section01.section
			.secWrap01
				.secPanel
					.txtBox
						h3.ttl01
							img(src=(root_path || '') + "image/features/features_mv_01_ttl_pc.png", class="switch" alt="01.調査診断")
						.txt
							p 建物・設備の特性、劣化状況を<br>把握するための調査診断を行います。
		#section02.section
			.secWrap01
				.secPanel
					.txtBox
						h3.ttl02
							img(src=(root_path || '') + "image/features/features_mv_02_ttl_pc.png", class="switch" alt="02.最適化提案")
						.txt
							p 調査診断結果を元に、<br class="spBreak">建物・設備の劣化状況を踏まえて<br>最適な提案を行います。
		#section03.section
			.secWrap01
				.secPanel
					.txtBox
						h3.ttl03
							img(src=(root_path || '') + "image/features/features_mv_03_ttl_pc.png", class="switch" alt="03.品質管理・技術管理")
						.txt
							p クオリティの高いサービスを提供するにあたり、<br>一定の品質を備えていることを検査・検証します。
		#section04.section
			.secWrap01
				.secPanel
					.txtBox
						h3.ttl04
							img(src=(root_path || '') + "image/features/features_mv_04_ttl_pc.png", class="switch" alt="04.工程管理")
						.txt
							p プロジェクトを予定通りに進めるために、<br>工程の進捗や労力、設備、<br class="spBreak">原材料などを管理します。
		#section05.section
			.secWrap01
				.secPanel
					.txtBox
						h3.ttl05
							img(src=(root_path || '') + "image/features/features_mv_05_ttl_pc.png", class="switch" alt="05.コスト管理")
						.txt
							p プロジェクトを予算内で完了させるために<br>コストを適切に管理します。
	.chartSection
		.secWrap01
			.txt
				p カトー建材工業の社員は、<br class="spBreak">整理整頓・安全管理を徹底し、<br>マナーを守り、安心・安全な工事を実現します。
			.chart
				img(src=(root_path || '') + "image/features/features_chart_pc.png", class="switch" alt="")
