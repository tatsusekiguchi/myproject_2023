// ▽メイン▽
main#memberMain.pageMain
	.pageKvPanel
		.pageKvTitle
			p Member
			h1 社員紹介
	.pageLinkContainer
		.secWrap01
			.pageLinkBox
				ul
					li
						.photo
							img(src=(root_path || '') + "image/member/member_top_staff_01.png", alt="")
						.nameBox
							a(href="#section01")
								dl
									dt 営業職
									dd 山本 正太郎
								p Click
					li
						.photo
							img(src=(root_path || '') + "image/member/member_top_staff_02.png", alt="")
						.nameBox
							a(href="#section02")
								dl
									dt 営業職
									dd 浅井 恵介
								p Click
	.sectionContainer
		#section01.section
			.mvContainer
				.secWrap01
					.mvPanel
						.mv
							img(src=(root_path || '') + "image/member/member_staff01_top.png", alt="")
						.num
							p 01
						.nameBox
							dl
								dt 営業職
								dd 山本 正太郎
			.videoPanel
				.secWrap01
					.videoThumbnail(data-video-id="1wLY0Sofw68")
						img(src=(root_path || '') + "image/member/member_staff01_video_thumbnail.png",  alt="")
			.message
				.secWrap01
					p 相手に的確に物事を伝えること、<br>そして信頼されることが大切。
			.introContainer
				.introPanel
					.photo
						img(src=(root_path || '') + "image/member/member_staff01_intro_01.png",  alt="")
					.txtBox
						.txt
							p 自分たちの仕事内容を把握し、元請から下請に伝達することは当然大事なことですが、仲介している営業の立場として相手に的確に物事を伝えること、そして信頼されることが大切だと自分なりに学びました。<br>現場をこなしていくうちに、相手が今、何を思っているのかをできる限り察知し、スムーズに対応することができるようになった時に成長を感じます。
				.introPanel
					.photo
						img(src=(root_path || '') + "image/member/member_staff01_intro_02.png",  alt="")
					.txtBox
						.txt
							p 新入社員に対して自分はできる限り近い距離感で接したいと思っています。歳の差を気にせずに言いたいこと、聞きたいことを迷いなく話してくれるような雰囲気にしようと心がけています。<br>そのためには、自分から新入社員の性格や人柄を知る必要があるので、仕事を教えることよりも先にコミュニケーションを取ることを大事にしています。
			.flowContainer
				.secWrap01
					.title
						img(src=(root_path || '') + "image/member/member_flow_title.png",  alt="")
					.photoList
						ul
							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff01_flow_01.png",  alt="")
								dl
									dt 8:00
									dd 朝礼<br>事務所又は<br class="pcBreak">現場管理

							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff01_flow_02.png",  alt="")
								dl
									dt 10:00
									dd 現場に移動し<br>打ち合わせ
							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff01_flow_03.png",  alt="")
								dl
									dt 13:00
									dd 現調、<br>現場管理
							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff01_flow_04.png",  alt="")
								dl
									dt 15:00
									dd 見積もり、<br>提出書類等の作成
							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff01_flow_05.png",  alt="")
								dl
									dt 16:00
									dd 材料の準備等<br>翌日の現場段取り
		#section02.section
			.mvContainer
				.secWrap01
					.mvPanel
						.mv
							img(src=(root_path || '') + "image/member/member_staff02_top.png", alt="")
						.num
							p 02
						.nameBox
							dl
								dt 営業職
								dd 浅井 恵介
			.videoPanel
				.secWrap01
					.videoThumbnail(data-video-id="wAyzhXTqj8M")
						img(src=(root_path || '') + "image/member/member_staff02_video_thumbnail.png",  alt="")
			.message
				.secWrap01
					p 効率の良い方法を考え、<br>実践することにやりがいを感じる。
			.introContainer
				.introPanel
					.photo
						img(src=(root_path || '') + "image/member/member_staff02_intro_01.png",  alt="")
					.txtBox
						.txt
							p 私が成長できたと感じることは、諸先輩方に仕事のイロハを教わり、ある程度一人で仕事を進めることができるようになったことです。<br>自分なりに効率の良い方法を考えて実践し、結果が出た時にはやりがいを感じます。
				.introPanel
					.photo
						img(src=(root_path || '') + "image/member/member_staff02_intro_02.png",  alt="")
					.txtBox
						.txt
							p 私もまだ見習いで、周りが見えていないことが多々あるので、情報を共有しながら接していきたいと思います。<br>もし後輩ができたなら、切磋琢磨しながら一緒に仕事を覚えていければいいなと思います。
			.flowContainer
				.secWrap01
					.title
						img(src=(root_path || '') + "image/member/member_flow_title.png",  alt="")
					.photoList
						ul
							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff02_flow_01.png",  alt="")
								dl
									dt 8:00
									dd メールの確認、<br>工事に関わる<br class="pcBreak">見積書内容の確認

							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff02_flow_02.png",  alt="")
								dl
									dt 10:00
									dd 工事現場の図面の確認<br>工事内容を理解する
							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff02_flow_03.png",  alt="")
								dl
									dt 13:00
									dd 塗装や防水の材料の<br class="pcBreak">片づけ整理整頓、<br>材料の性能等把握、<br>明日の工事の準備・段取り
							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff02_flow_04.png",  alt="")
								dl
									dt 15:00
									dd 在庫の管理、<br>在庫のエクセル<br class="pcBreak">データ入力
							li
								.photo
									img(src=(root_path || '') + "image/member/member_staff02_flow_05.png",  alt="")
								dl
									dt 16:00
									dd 新規営業、<br class="pcBreak">ルート営業のための<br>工事数量の入力及び積算
// △メイン△