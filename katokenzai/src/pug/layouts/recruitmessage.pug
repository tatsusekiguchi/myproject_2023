// ▽メイン▽
main#recruitmessageMain.pageMain
	.pageKvPanel
		.pageKvTitle
			p Recruit Message
			h1 採用メッセージ
	.topContainer
		.secWrap
			.topTitleBox
				.topTitle
					img(src=(root_path || '') + "image/recruitmessage/recruitmessage_top_title.png", alt="")
			.secBox
				.txtBox
					h2
						| 時代は移り変わる、
						br
						| だから
						em 色
						| を替えていこう。
					.txt
						p 時代は確実に変わっていく。<br>求められるニーズは多様化する。<br>それに応えるテクノロジーは進化する。<br>新たなチャレンジ、新たな付加価値が必要とされる。<br>でも、私たちの使命は変わることはない。<br>自分らしく、突き進もう！

				.slash
					img(src=(root_path || '') + "image/recruitmessage/recruitmessage_top_slash.png", alt="")
	.videoPanel
		.secWrap01
			.videoThumbnail(data-video-id="lzelAGvh4UM")
				img(src=(root_path || '') + "image/recruitmessage/recruitmessage_video_thumbnail.png",  alt="")
	.mv
		img(src=(root_path || '') + "image/recruitmessage/recruitmessage_mv_01_pc.png", class="switch" alt="")
	.section01
		.secWrap
			h2 カトー建材工業で<br>身に付くスキル
			.topTxt
				.txt
					p ヒアリング力・洞察力・論理分析力・提案力・交渉力・人脈力など、<br>仕事を通じて社会人として必要な様々なスキルが身につきます。
			.chart
				img(src=(root_path || '') + "image/recruitmessage/recruitmessage_chart.png", alt="")
			.flowBoxList
				.flowBox
					dl
						dt
							span 01
							em ヒアリング力
						dd お客様の本音を聞き出す、<br class="spBreak">信頼関係を築く、情報を共有する力
				.flowBox
					dl
						dt
							span 02
							em 洞察力
						dd 物事の本質を見抜く、人の心理を見抜く力
				.flowBox
					dl
						dt
							span 03
							em 論理分析力
						dd 情報や状況を整理・分析する、<br class="spBreak">論理的に順序立てて草案をつくる力
				.flowBox
					dl
						dt
							span 04
							em 提案力
						dd 専門的な情報や数値的な根拠などを用いて、<br class="spBreak">メリットとデメリットの<br class="pcBreak">双方から最適解を導き出し、<br class="spBreak">お客様が納得できる提案を行う力
				.flowBox
					dl
						dt
							span 05
							em 交渉力
						dd お互いの利害を踏まえての<br class="spBreak">提言・交渉・役立つ助言ができる力
				.flowBox
					dl
						dt
							span 06
							em 人脈力
						dd 世代を超えた人間関係の構築、商談の<br class="spBreak">チャンスや顧客紹介を拡大させる力
// △メイン△