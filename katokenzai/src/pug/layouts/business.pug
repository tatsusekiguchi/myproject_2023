// ▽メイン▽
main#businessMain.pageMain
	.pageKvPanel
		.pageKvTitle
			p Our business
			h1 事業・サービス領域
	.topTitlePanel
		.secWrap01
			h2 建物の美観を護る<br>街の景観を護る
			.txt
				p カトー建材工業は<br class="spBreak">、塗装工事・防水工事・住まいのリフォームを中心に、<br>建物の美観を護る事業を展開しております。<br>建物の美観を通じて<br class="spBreak">街の景観も新しく塗り替えていきます。
			.pageLinkBox
				ul
					li.link01
						a(href="#section01")
							.ttl
								p 塗装工事
							.linkButton
								img(src=(root_path || '') + "image/business/business_top_click_pc.png", class="switch" alt="")
					li.link02
						a(href="#section02")
							.ttl
								p 防水工事
							.linkButton
								img(src=(root_path || '') + "image/business/business_top_click_pc.png", class="switch" alt="")
					li.link03
						a(href="#section03")
							.ttl
								p 住まいの<br>リフォーム
							.linkButton
								img(src=(root_path || '') + "image/business/business_top_click_pc.png", class="switch" alt="")
	.sectionContainer
		#section01.section
			.mv
				.mvTitle
					p Painting Work
					h3 塗装工事
			.secWrap01
				.secPanel
					.txtBox
						.txt
							p 塗装工事の目的は「美観と保護」にあります。<br>当社は主に建築塗装をおこなっています。<br>豊富な塗装経験を基に塗装する<br class="spBreak">下地・建物の形状に適した<br>材料を選定し適切な方法で施工する、<br class="spBreak">当たり前のことを当たり前に行う。<br>これが当社のこだわりです。
						.list
							img(src=(root_path || '') + "image/business/business_sec_list_01.png", alt="")
					.photo
						img(src=(root_path || '') + "image/business/business_sec_img_01.png", alt="")
		#section02.section
			.mv
				.mvTitle
					p Waterproof Work
					h3 防水工事
			.secWrap01
				.secPanel
					.txtBox
						.txt
							p 防水工事は屋上・バルコニー等から建物内部に<br>侵入しようとする雨水を防ぐことを目的としています。<br>こだわりとしては「適材適所・適切工法」<br class="spBreak">つまり下地の状況を考慮し<br>適切な材料・工法を選択し、<br>より長く建物を保護できる良質な施工を行う、<br class="spBreak">これが全てです。
						.list
							img(src=(root_path || '') + "image/business/business_sec_list_02.png", alt="")
					.photo
						img(src=(root_path || '') + "image/business/business_sec_img_02.png", alt="")
		#section03.section
			.mv
				.mvTitle
					p Home Renovation
					h3 住まいのリフォーム
			.secWrap01
				.secPanel
					.txtBox
						.txt
							p 当社が行うリフォームは年数が経った<br class="spBreak">住宅の外壁の塗装・屋上の<br>防水工事に合わせて樋の取り換え、<br class="spBreak">玄関ドアの取り換え、<br class="spBreak">カーポートの設置、<br>また部屋のクロスの張り替え、<br class="spBreak">フローリング床の張り替えなど様々です。<br>こだわりは信頼できる協力業者と共により<br class="spBreak">良い提案をおこない、<br>お客様の暮らしの中にある笑顔に貢献することです。
						.list.single
							img(src=(root_path || '') + "image/business/business_sec_list_03.png", alt="")
					.photo
						img(src=(root_path || '') + "image/business/business_sec_img_03.png", alt="")
// △メイン△