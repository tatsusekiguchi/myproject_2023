// ▽メイン▽
.landMain.main
	.pageKvPanel
		.pageKvTitle
			h2 土地活用サービス
	.section
		.landContainer__top
			.secWrap01
				.pageSecTtlBox
					.pageSecTtl
						h3 土地活用をプロデュース
					.sub
						p Land_usage
				.checkPanel
					.inner
						.ul
							.li
								p 相続後の空き地を活用したい。
							.li
								p 遠方の所有地の管理が大変。
							.li
								p 家を建てるまで土地を活用したい。
						.ul
							.li
								p 毎月の安定収入があると安心。
							.li
								p 変形地で、どのように活用したらいいのかわからない。
							.li
								p 人が住めない古家をどうしていいかわからない。
				.arrow
					img(src="https://westservice.co.jp/system_panel/uploads/images/land_top_arrow.png", alt="")
				.message
					img(src="https://westservice.co.jp/system_panel/uploads/images/land_top_txt.png", alt="")
		.landContainer__merit
			.secWrap01
				.topTitleBox
					.ttl
						h4 WESTサービスの土地活用プロデュースのメリット
				.listBox
					.ul
						.li
							.photo
								img(src="https://westservice.co.jp/system_panel/uploads/images/land_merit_01.png", alt="")
							.txt
								p 毎月安定収入を実現します
							.txt
								p 未利用の土地をコインパーキングとして活用することで、安定した収益を得ることができます。<br>需要が高いエリアあれば、駐車場は常に需要が見込めます。
						.li
							.photo
								img(src="https://westservice.co.jp/system_panel/uploads/images/land_merit_02.png", alt="")
							.txt
								p 掃や集金、クレーム対応も不要
							.txt
								p コインパーキングの日々の作業は全て弊社にて承ります。24時間対応のコールセンター、修理対応スタッフによる迅速な対応で満足度の高いサポートに自信があります。
						.li
							.photo
								img(src="https://westservice.co.jp/system_panel/uploads/images/land_merit_03.png", alt="")
							.txt
								p 初期費用が不要
							.txt
								p 一括借り上げの場合はコインパーキングの設置にかかる費用は一切かかりません。<br>持て余していた土地の有効活用であらたな価値を生み出します。
		.landContainer__flow
			.secWrap01
				.pageFlowSection
					.flowSection
						.topTitleBox
							.ttl
								h4 オーナー様に合わせた最適なプランでどんなお悩みも解決！
							p コインパーキングは都市部を中心に益々重要な役割を果たしています。<br>そんな中、多くの土地所有者様はそのスペースを十分に利用していないケースがございます。<br>WESTサービスでは、未利用の土地を現代の需要に合った駐車場として開発し、オーナー様に最適なプランとして提案いたします。
						.pageFlowContainer
							.flowPanel
								.flowBox
									.ttlNumTxt
										.ttlNumBox
											.ttlNum
												p.span Step
												p.em 1
										.ttlTxtBox
											p まずはご相談ください
									.detailBox
										.txtBox
											.txt
												p お持ちの土地についてのお困りごとをまずはお聞かせください。<br>住所や周囲の環境、今後どのように活用されていきたいかなど、お困りごとから今後の展望まで丁寧にヒアリングさせていただきます。
										.photo
											img(src="https://westservice.co.jp/system_panel/uploads/images/land_flow_01.png", alt="")
							.flowPanel
								.flowBox
									.ttlNumTxt
										.ttlNumBox
											.ttlNum
												p.span Step
												p.em 2
										.ttlTxtBox
											p 収益シミュレーションを提示します
									.detailBox
										.txtBox
											.txt
												p ご要望や問題点をヒアリングさせていただきました後に、現地調査を実施し、精度の高いコインパーキング運営の収益シミュレーションを提示いたします。
												p 平日、休日の混雑状況など、日々移り変わる人々の営みを毎日肌で触れてきた我々だからこそ分かるアドバイスをいたします。
										.photo
											img(src="https://westservice.co.jp/system_panel/uploads/images/land_flow_02.png", alt="")
							.flowPanel
								.flowBox
									.ttlNumTxt
										.ttlNumBox
											.ttlNum
												p.span Step
												p.em 3
										.ttlTxtBox
											p 運営会社と連携して最適なプランを提案します
									.detailBox
										.txtBox
											.txt
												p 弊社と提携しております運営会社様を紹介させていただき、お客様に最適なプランを提案させていただきます。
										.photo
											img(src="https://westservice.co.jp/system_panel/uploads/images/land_flow_03.png", alt="")
							.flowPanel
								.flowBox
									.ttlNumTxt
										.ttlNumBox
											.ttlNum
												p.span Step
												p.em 4
										.ttlTxtBox
											p オープン後の日々のメンテナンスもお任せ下さい
									.detailBox
										.txtBox
											.txt
												p コインパーキングは作って終わりではありません。<br>日々のご利用者様の対応から集金対応までWESTサービスがきめ細かいサポートで安心をお約束いたします。
										.photo
											img(src="https://westservice.co.jp/system_panel/uploads/images/land_flow_04.png", alt="")
// △メイン△