// ▽メイン▽
.productMain.main.serviceMain
	.pageHeadTitlePanel
		.pageHeadTitle
			p PRODUCT DEVELOPMENT
			h1 商品開発
	.mainContainer
		.topSection
			.topContainer
				.dl
					.dt.fadeUp
						h2 動作の専門家が監修し、商品の魅力を最大限に引き出す。
					.dd.fadeUp
						.txt
							p 健康商品が世の中に溢れている中、新しい商品を開発する。<br>そこには「もっと良いものを作りたい」という想いがあるはずです。<br>理学療法士が専門的な知見を持って商品開発に参加することで、<br>より効果的な商品づくりや使い方の提案が可能です。<br>20年以上の理学療法士としての経験を活かし、<br>貴社の商品開発をサポートいたします。
		.sec01
			.secWrap01
				.pageSecTtlBox.fadeUp
					p APPROACH
					.pageSecTtl
						h2 リハの木ができる健康経営のサポート
				.topPanel
					.secBox.fadeUp
						.title
							h3 こんなお悩みに寄り添います
						.ul
							.li
								p 専門的な人の<br>意見が欲しい
							.li
								p 効果について<br>数字で示したい
							.li
								p 商品のリニューアル<br>を考えている
							.li
								p 理学療法士を<br>雇うほどではない
							.li
								p プロジェクト<br>メンバーに<br>理学療法士が欲しい
				.secPanelList
					.secPanel.fadeUp
						.photo
							img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/product_sec01_img_01.png", alt="")
						.txtBox
							.ttl
								h3 データを用いた商品開発で精度を高める
							.txt
								p 理学療法士の専門領域である「動作」の部分での助言や提案をいたします。<br>運動力学・人間工学・運動学・解剖学の観点からの解析や予測を行います。<br>科学的な根拠に基づいた設計をすることで、説得力のある実用的な商品開発が可能になります。<br>商品企画の段階から参加することも、検証のみお任せいただくこともできます。
					.secPanel.fadeUp
						.photo
							img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/product_sec01_img_02.png", alt="")
						.txtBox
							.ttl
								h3 ユーザー中心の設計と安全性の確保
							.txt
								p これまで病院など福祉施設で働いてきた経験から、患者や利用者のニーズについては細かく把握しています。<br>ユーザーの生活に合わせた製品の設計が可能です。<br>また、ユーザーの安全性を第一に考え、テスト段階での安全性の検証を重視しています。
					.secPanel.fadeUp
						.photo
							img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/product_sec01_img_03.png", alt="")
						.txtBox
							.ttl
								h3 製品の最適な使い方を提案
							.txt
								p 完成した商品をどのように使うのが効果的か。<br>身体効率がよく体に無理をさせない使い方を提案します。<br>理学療法士は、どの姿勢でどこに負荷がかかるのか、どの姿勢にしたら負荷が軽くなるのかを判断することができます。<br>無理なく効果的に使い続けてもらうための使い方の提案は、私たちにお任せください。
		.sec02
			.secContainer
				.secWrap01
					.pageSecTtlBox.fadeUp
						p STRENGTH
						.pageSecTtl
							h2 リハの木が得意とする商品開発のサポート
					.listBox
						.ul.boxAnim
							.li.target01.target
								.icon
									img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/product_sec02_icon_01.png", alt="")
								.dl
									.dt
										p 予後予測
									.dd
										p 怪我や不調がどれくらいの期間で改善するのか、商品を使用することによる効果を予測することができます。
							.li.target02.target
								.icon
									img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/product_sec02_icon_02.png", alt="")
								.dl
									.dt
										p 障害予防
									.dd
										p 腰痛予防や肩こり予防などの商品の場合、なぜこの商品が予防になるのか、専門的な知見から理由付けをすることが可能です。
							.li.target03.target
								.icon
									img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/product_sec02_icon_03.png", alt="")
								.dl
									.dt
										p 老年医学
									.dd
										p リハの木は老年医学を得意としていますので、年齢による障害や怪我の発生の理由などの説明や介護予防の分野はお任せください。
		.sec03
			.secWrap01
				.pageSecTtlBox.fadeUp
					p EXAMPLE
					.pageSecTtl
						h2 商品開発例
				.secBox01.fadeUp
					h3 人が使用する商品であれば対応可能
					.txt
						p 基本的に、人が使用する商品であれば商品開発のサポートが可能です。<br>多くの商品開発に携わることで、理学療法士の可能性を広げていきたいと考えています。<br>商品例は以下になりますが、ここにない商品の場合もまずはご相談ください。
				.secBox02.fadeUp
					.dl
						.dt
							p 【商品例】
						.dd
							p ケア・運動関連商品､リラクゼーションアイテム、ウエア、アンダーウエア、靴下、ストッキング、靴、PC 関連商品、家電、道具、家具、クッション、枕、マットレス、玩具、文房具、自動車・自転車ツール
		.worksSection
			.secWrap01
				.titlePanel.fadeUp
					.pageSecTtlBox
						p WORKS
						.pageSecTtl
							h2 実績紹介
				.secBox.fadeUp
					.photo
						img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/product_sec04_img.png", alt="")
					.txtBox
						.ttl
							h3 健康器具の商品開発
						.txt
							p 〇〇株式会社様とのコラボ商品である〇〇が発売されました。<br>この商品は〇〇予防のための〇〇です。<br>商品企画の段階から参加させていただき、〇〇の動きにつてなど、様々な助言をさせていただきました。<br>効果についてもデータ分析、検証を重ねることでより効果的な商品を作ることができました。<br>みなさまもぜひ、手に取ってみてください。
				.worksListBox.fadeUp
					.titlePanel
						.pageSecTtlBox
							p 実績一覧
						.txt
							p その他の実績はこちらからご覧ください。
						.btnMore
							a(href="workslist")
								div
									p VIEW MORE
					section.webgene-blog
						.webgene-header
							h3 実績一覧
						.webgene-item
							a(href="")
								.photo
									img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/top_sec03_img.png", alt="")
								.txtBox
									.infoBox
										.time
											p 2023.05.19
										.cate
											p お知らせ
									.title
										p コラボ商品が発売されました。
						.webgene-item
							a(href="")
								.photo
									img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/top_sec03_img.png", alt="")
								.txtBox
									.infoBox
										.time
											p 2023.05.19
										.cate
											p お知らせ
									.title
										p コラボ商品が発売されました。
						.webgene-item
							a(href="")
								.photo
									img(src="https://rihanoki230831.smooooth.jp/system_panel/uploads/images/top_sec03_img.png", alt="")
								.txtBox
									.infoBox
										.time
											p 2023.05.19
										.cate
											p お知らせ
									.title
										p コラボ商品が発売されました。
