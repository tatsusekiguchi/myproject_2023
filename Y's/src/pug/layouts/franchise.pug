    .sec04
        .secWrap01
            .pageSecTtl.center
                p Contact
                h2 フランチャイズのお問い合わせ
            .topTxt
                .txt
                    p メールでのお問い合わせは下記のフォームからご要望事項を記入の上 送信をお願いします。<br>※ご記入いただいたメールアドレスにメールにてご連絡いたしますので、メールアドレスは正確にご入力ください。<br>こちらのお問い合わせフォームからのセールス・勧誘等は固くお断りいたします、送信いただいても対応いたしかねます。
            .contactForm
                form(data-formtype="1" method="post" action="contactComplete" name="form").form
                    .formBox.gothic
                        .dl
                            .dt
                                p.span 担当者名
                                p.em 必須
                            .dd
                                input(type="text" class="name" name="name" placeholder="例）山田 太郎" data-displaynameattr="担当者名").validateRequired
                        .dl
                            .dt
                                p.span 店舗名
                                p.em 必須
                            .dd
                                input(type="text" class="shop" name="shop" placeholder="例）株式会社ワイズ" data-displaynameattr="店舗名").validateRequired
                        .dl.postal
                            .dt
                                p.span 郵便番号
                                p.em 必須
                            .dd
                                p.postalTxt 〒
                                input(type="text" class="postal_01 zip1" name="postal_01" placeholder="123" data-displaynameattr="郵便番号上3桁" ).validateRequired
                                p.span -
                                input(type="text" class="postal_02 zip2" name="postal_02" placeholder="4567" data-displaynameattr="郵便番号下4桁" ).validateRequired
                        .dl
                            .dt
                                p.span 住所
                                p.em 必須
                            .dd
                                input(type="text" class="address01" name="address01" placeholder="例）神奈川県藤沢市弥勒寺2‐1‐6小倉ビル402" data-displaynameattr="住所").validateRequired
                        .dl
                            .dt
                                p.span 電話番号
                                p.em 必須
                            .dd
                                input(type="text" class="tel" name="tel" placeholder="例）0123-45-6789" data-displaynameattr="電話番号").validatePhone1
                        .dl
                            .dt
                                p.span メールアドレス
                                p.em 必須
                            .dd
                                input(type="email" class="mail" name="mail" placeholder="例）mail@example.com" data-displaynameattr="メールアドレス").validateEmail
                        .dl
                            .dt
                                p.span メールアドレス（確認用）
                                p.em 必須
                            .dd
                                input(type="email" class="mailConfirm" name="mailConfirm" placeholder="確認のため再度お願いいたします。" data-displaynameattr="確認用メールアドレス").validateEmail
                        .dl
                            .dt
                                p.span 電話をかける希望の時間帯
                            .dd
                                .dateBox
                                    p.em 第一希望
                                    input(type="text" class="dateInput" name="hour1" data-displaynameattr="第1希望時")
                                    p.span 時
                                    input(type="text" class="dateInput" name="minute1" data-displaynameattr="第1希望分")
                                .dateBox
                                    p.em 第二希望
                                    input(type="text" class="dateInput" name="hour2" data-displaynameattr="第2希望時")
                                    p.span 時
                                    input(type="text" class="dateInput" name="minute2" data-displaynameattr="第2希望分")
                                .txt
